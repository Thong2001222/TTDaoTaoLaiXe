@model TTDaoTaoLaiXe.Models.HocVien

@{
    ViewData["Title"] = "Thêm học viên";
}

<div class="container-fluid">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                Thêm học viên
            </h2>

            <p class="text-muted mb-0">
                Nhập thông tin học viên mới
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>
            Quay lại

        </a>

    </div>


    <!-- FORM -->
    <div class="dashboard-card">

        <form asp-action="Create"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>


            <!-- THÔNG TIN CƠ BẢN -->

            <h5 class="fw-semibold mb-3">
                <i class="bi bi-person-vcard text-primary me-2"></i>
                Thông tin cá nhân
            </h5>


            <div class="row g-3">


                <!-- MÃ HỌC VIÊN -->

                <div class="col-md-4">

                    <label asp-for="MaHocVien"
                           class="form-label">
                        Mã học viên
                    </label>

                    <input asp-for="MaHocVien"
                           class="form-control"
                           placeholder="VD: HV0003" />

                    <span asp-validation-for="MaHocVien"
                          class="text-danger">
                    </span>

                </div>


                <!-- HỌ TÊN -->

                <div class="col-md-8">

                    <label asp-for="HoTen"
                           class="form-label">
                        Họ và tên
                    </label>

                    <input asp-for="HoTen"
                           class="form-control"
                           placeholder="Nhập họ và tên" />

                    <span asp-validation-for="HoTen"
                          class="text-danger">
                    </span>

                </div>


                <!-- NGÀY SINH -->

                <div class="col-md-4">

                    <label asp-for="NgaySinh"
                           class="form-label">
                        Ngày sinh
                    </label>

                    <input asp-for="NgaySinh"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="NgaySinh"
                          class="text-danger">
                    </span>

                </div>


                <!-- GIỚI TÍNH -->

                <div class="col-md-4">

                    <label asp-for="GioiTinh"
                           class="form-label">
                        Giới tính
                    </label>

                    <select asp-for="GioiTinh"
                            class="form-select">

                        <option value="">
                            -- Chọn giới tính --
                        </option>

                        <option value="Nam">
                            Nam
                        </option>

                        <option value="Nữ">
                            Nữ
                        </option>

                    </select>

                    <span asp-validation-for="GioiTinh"
                          class="text-danger">
                    </span>

                </div>


                <!-- CCCD -->

                <div class="col-md-4">

                    <label asp-for="Cccd"
                           class="form-label">
                        CCCD
                    </label>

                    <input asp-for="Cccd"
                           class="form-control"
                           maxlength="12"
                           placeholder="12 số CCCD" />

                    <span asp-validation-for="Cccd"
                          class="text-danger">
                    </span>

                </div>


                <!-- NGÀY CẤP CCCD -->

                <div class="col-md-6">

                    <label asp-for="NgayCapCccd"
                           class="form-label">
                        Ngày cấp CCCD
                    </label>

                    <input asp-for="NgayCapCccd"
                           type="date"
                           class="form-control" />

                </div>


                <!-- NƠI CẤP -->

                <div class="col-md-6">

                    <label asp-for="NoiCapCccd"
                           class="form-label">
                        Nơi cấp CCCD
                    </label>

                    <input asp-for="NoiCapCccd"
                           class="form-control"
                           placeholder="Nhập nơi cấp" />

                </div>


                <!-- SỐ ĐIỆN THOẠI -->

                <div class="col-md-6">

                    <label asp-for="SoDienThoai"
                           class="form-label">
                        Số điện thoại
                    </label>

                    <input asp-for="SoDienThoai"
                           class="form-control"
                           maxlength="15"
                           placeholder="VD: 0912345678" />

                    <span asp-validation-for="SoDienThoai"
                          class="text-danger">
                    </span>

                </div>


                <!-- EMAIL -->

                <div class="col-md-6">

                    <label asp-for="Email"
                           class="form-label">
                        Email
                    </label>

                    <input asp-for="Email"
                           type="email"
                           class="form-control"
                           placeholder="example@gmail.com" />

                    <span asp-validation-for="Email"
                          class="text-danger">
                    </span>

                </div>


                <!-- ĐỊA CHỈ -->

                <div class="col-12">

                    <label asp-for="DiaChi"
                           class="form-label">
                        Địa chỉ
                    </label>

                    <input asp-for="DiaChi"
                           class="form-control"
                           placeholder="Nhập địa chỉ" />

                </div>


                <!-- GHI CHÚ -->

                <div class="col-12">

                    <label asp-for="GhiChu"
                           class="form-label">
                        Ghi chú
                    </label>

                    <textarea asp-for="GhiChu"
                              class="form-control"
                              rows="3"
                              placeholder="Thông tin ghi chú nếu có">
                    </textarea>

                </div>


                <!-- TRẠNG THÁI -->

                <div class="col-md-4">

                    <div class="form-check form-switch mt-4">

                        <input asp-for="TrangThai"
                               class="form-check-input"
                               type="checkbox"
                               checked />

                        <label asp-for="TrangThai"
                               class="form-check-label">
                            Đang hoạt động
                        </label>

                    </div>

                </div>

            </div>


            <!-- BUTTON -->

            <hr class="my-4" />

            <div class="d-flex justify-content-end gap-2">

                <a asp-action="Index"
                   class="btn btn-light border">

                    Hủy

                </a>

                <button type="submit"
                        class="btn btn-primary">

                    <i class="bi bi-check-lg me-1"></i>

                    Lưu học viên

                </button>

            </div>

        </form>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}