@model TTDaoTaoLaiXe.Models.LopHoc

@{
    ViewData["Title"] = "Chi tiết lớp học";

    var danhSachHocVien = Model.HocVienLopHocs?
        .OrderBy(x => x.NgayVaoLop)
        .ToList()
        ?? new List<TTDaoTaoLaiXe.Models.HocVienLopHoc>();

    int soHocVien = danhSachHocVien.Count(x =>
        x.TrangThai == "Đang học" && !x.NgayRaLop.HasValue);

    int siSoToiDa = Model.SiSoToiDa;
    int soChoConLai = Math.Max(0, siSoToiDa - soHocVien);

    double phanTramSiSo = siSoToiDa > 0
        ? Math.Min(100, (double)soHocVien / siSoToiDa * 100)
        : 0;

    bool choPhepXepHocVien =
        Model.TrangThai == "Đang mở" ||
        Model.TrangThai == "Đang học";

    string trangThaiClass = Model.TrangThai switch
    {
        "Đang mở" => "text-bg-primary",
        "Đang học" => "text-bg-success",
        "Tạm ngưng" => "text-bg-warning",
        "Đã kết thúc" => "text-bg-secondary",
        _ => "text-bg-light"
    };
}

<link rel="stylesheet"
      href="~/css/lophoc-details.css"
      asp-append-version="true" />

<div class="container-fluid py-4 lop-detail-page">

    <!-- TIÊU ĐỀ -->
    <div class="page-heading d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <div class="breadcrumb-text mb-2">
                <a asp-action="Index">Quản lý lớp học</a>
                <i class="bi bi-chevron-right mx-1"></i>
                <span>@Model.MaLopHoc</span>
            </div>

            <h2 class="page-title mb-1">@Model.TenLopHoc</h2>
            <p class="text-muted mb-0">
                Chi tiết thông tin, học viên và lịch học của lớp
            </p>
        </div>

        <a asp-action="Index" class="btn btn-light border">
            <i class="bi bi-arrow-left me-1"></i>
            Quay lại danh sách
        </a>
    </div>

    <!-- THÔNG TIN LỚP -->
    <div class="card detail-card mb-4">
        <div class="card-header detail-card-header">
            <div>
                <h5 class="section-title mb-1">
                    <i class="bi bi-info-circle text-primary me-2"></i>
                    Thông tin lớp học
                </h5>
                <small class="text-muted">
                    Thông tin cơ bản của lớp đào tạo
                </small>
            </div>

            <span class="badge @trangThaiClass status-badge">
                @Model.TrangThai
            </span>
        </div>

        <div class="card-body p-4">
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="info-label">Mã lớp học</div>
                    <div class="info-value">
                        <span class="code-badge">@Model.MaLopHoc</span>
                    </div>
                </div>

                <div class="col-md-8">
                    <div class="info-label">Tên lớp học</div>
                    <div class="info-value">@Model.TenLopHoc</div>
                </div>

                <div class="col-md-6">
                    <div class="info-label">Khóa đào tạo</div>
                    <div class="info-value">
                        <i class="bi bi-journal-text text-primary me-1"></i>
                        @(Model.MaKhoaHocNavigation?.TenKhoaHoc ?? "Chưa có thông tin")
                        <span class="text-muted fw-normal">(@Model.MaKhoaHoc)</span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="info-label">Giáo viên phụ trách</div>
                    <div class="info-value">
                        @if (Model.MaGiaoVienNavigation != null)
                        {
                            <i class="bi bi-person-badge text-primary me-1"></i>
                            @Model.MaGiaoVienNavigation.HoTen
                            <span class="text-muted fw-normal">(@Model.MaGiaoVien)</span>
                        }
                        else
                        {
                            <span class="text-muted fw-normal">
                                <i class="bi bi-person-x me-1"></i>
                                Chưa phân công giáo viên
                            </span>
                        }
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="info-label">Ngày bắt đầu</div>
                    <div class="info-value">
                        <i class="bi bi-calendar-event text-primary me-1"></i>
                        @Model.NgayBatDau.ToString("dd/MM/yyyy")
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="info-label">Ngày kết thúc</div>
                    <div class="info-value">
                        @if (Model.NgayKetThuc.HasValue)
                        {
                            <i class="bi bi-calendar-check text-success me-1"></i>
                            @Model.NgayKetThuc.Value.ToString("dd/MM/yyyy")
                        }
                        else
                        {
                            <span class="text-muted">Chưa xác định</span>
                        }
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="info-label">Sĩ số tối đa</div>
                    <div class="info-value">
                        <i class="bi bi-people text-primary me-1"></i>
                        @siSoToiDa học viên
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.MoTa))
                {
                    <div class="col-12">
                        <hr class="section-divider" />
                        <div class="info-label">Mô tả</div>
                        <div class="description-text">@Model.MoTa</div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- CẬP NHẬT TRẠNG THÁI -->
    <div class="card detail-card mb-4">
        <div class="card-body p-4">
            <div class="row align-items-center g-3">
                <div class="col-lg-5">
                    <div class="d-flex align-items-center gap-3">
                        <div class="stat-icon icon-purple">
                            <i class="bi bi-arrow-repeat"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-1">Trạng thái lớp học</h6>
                            <small class="text-muted">
                                Cập nhật tình trạng đào tạo
                            </small>
                        </div>
                    </div>
                </div>

                <div class="col-lg-7">

                    <form asp-action="ChangeStatus"
                          method="post"
                          id="formChangeStatus"
                          class="d-flex flex-wrap justify-content-lg-end gap-2">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="id"
                               value="@Model.MaLopHoc" />

                        <select name="trangThai"
                                id="selectTrangThai"
                                class="form-select status-select"
                                aria-label="Chọn trạng thái lớp học"
                                disabled="@(Model.TrangThai == "Đã kết thúc")">

                            <option value="Đang mở"
                                    selected="@(Model.TrangThai == "Đang mở")">
                                Đang mở
                            </option>

                            <option value="Đang học"
                                    selected="@(Model.TrangThai == "Đang học")">
                                Đang học
                            </option>

                            <option value="Tạm ngưng"
                                    selected="@(Model.TrangThai == "Tạm ngưng")">
                                Tạm ngưng
                            </option>

                            <option value="Đã kết thúc"
                                    selected="@(Model.TrangThai == "Đã kết thúc")">
                                Đã kết thúc
                            </option>
                        </select>

                        <button type="submit"
                                id="btnChangeStatus"
                                class="btn btn-outline-primary"
                                disabled="@(Model.TrangThai == "Đã kết thúc")">
                            <i class="bi bi-check2 me-1"></i>
                            Cập nhật trạng thái
                        </button>
                    </form>

                    @if (Model.TrangThai == "Đã kết thúc")
                    {
                        <small class="text-muted d-block mt-2">
                            <i class="bi bi-lock-fill me-1"></i>
                            Lớp đã kết thúc nên không thể thay đổi trạng thái.
                        </small>
                    }

                </div>
            </div>
        </div>
    </div>

    <!-- THỐNG KÊ -->
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card stat-card h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between gap-3">
                        <div>
                            <div class="stat-label">Học viên đang học</div>
                            <div class="stat-number">
                                @soHocVien <span>/ @siSoToiDa</span>
                            </div>
                        </div>

                        <div class="stat-icon icon-blue">
                            <i class="bi bi-people"></i>
                        </div>
                    </div>

                    <div class="progress mt-3"
                         role="progressbar"
                         aria-valuenow="@soHocVien"
                         aria-valuemin="0"
                         aria-valuemax="@siSoToiDa">
                        <div class="progress-bar bg-primary"
                             style="width: @phanTramSiSo.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%">
                        </div>
                    </div>

                    <div class="stat-footnote mt-2">
                        Đã sử dụng @phanTramSiSo.ToString("0")% sức chứa.
                        Còn @soChoConLai chỗ trống.
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card stat-card h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between gap-3">
                        <div>
                            <div class="stat-label">Tổng số buổi học</div>
                            <div class="stat-number">
                                @(Model.LichHocs?.Count ?? 0)
                            </div>
                            <div class="stat-footnote">
                                Buổi học đã được lên lịch
                            </div>
                        </div>

                        <div class="stat-icon icon-green">
                            <i class="bi bi-calendar-week"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- DANH SÁCH HỌC VIÊN -->
    <div class="card detail-card mb-4">
        <div class="card-header detail-card-header">
            <div>
                <h5 class="section-title mb-1">
                    <i class="bi bi-people text-primary me-2"></i>
                    Danh sách học viên
                </h5>
                <small class="text-muted">
                    Theo dõi học viên đang học và lịch sử tham gia lớp
                </small>
            </div>

            <div class="d-flex flex-wrap align-items-center gap-2">
                <span class="badge rounded-pill bg-primary-subtle text-primary px-3 py-2">
                    @soHocVien đang học
                </span>

                @if (choPhepXepHocVien && soChoConLai > 0)
                {
                    <button type="button"
                            class="btn btn-primary"
                            data-bs-toggle="modal"
                            data-bs-target="#modalXepHocVien">
                        <i class="bi bi-person-plus me-1"></i>
                        Xếp học viên
                    </button>
                }
                else if (choPhepXepHocVien)
                {
                    <button type="button" class="btn btn-outline-secondary" disabled>
                        <i class="bi bi-people me-1"></i>
                        Đã đủ sĩ số
                    </button>
                }
            </div>
        </div>

        <div class="card-body p-0">
            @if (danhSachHocVien.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle table-modern mb-0">
                        <thead>
                            <tr>
                                <th class="ps-4">#</th>
                                <th>Học viên</th>
                                <th>Mã học viên</th>
                                <th>Ngày vào lớp</th>
                                <th>Ngày ra lớp</th>
                                <th>Trạng thái</th>
                                <th class="text-end pe-4">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int stt = 1;
                            }

                            @foreach (var hv in danhSachHocVien)
                            {
                                bool dangHoc =
                                hv.TrangThai == "Đang học" &&
                                !hv.NgayRaLop.HasValue;

                                <tr class="@(dangHoc ? "" : "history-row")">
                                    <td class="ps-4 text-muted">@stt</td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="student-avatar">
                                                <i class="bi bi-person"></i>
                                            </div>
                                            <div>
                                                <div class="student-name">
                                                    @(hv.MaHocVienNavigation?.HoTen ?? "Không có thông tin")
                                                </div>

                                                @if (!dangHoc &&
                                                                                        !string.IsNullOrWhiteSpace(hv.LyDoRaLop))
                                                {
                                                    <small class="text-muted">
                                                        Lý do: @hv.LyDoRaLop
                                                    </small>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="code-badge">@hv.MaHocVien</span>
                                    </td>
                                    <td>@hv.NgayVaoLop.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        @if (hv.NgayRaLop.HasValue)
                                        {
                                            @hv.NgayRaLop.Value.ToString("dd/MM/yyyy")
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td>
                                        @if (dangHoc)
                                        {
                                            <span class="badge text-bg-success status-badge">
                                                Đang học
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge text-bg-secondary status-badge">
                                                @hv.TrangThai
                                            </span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        @if (dangHoc && choPhepXepHocVien)
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger btn-roi-lop"
                                                    data-ma-hoc-vien="@hv.MaHocVien"
                                                    data-ho-ten="@(hv.MaHocVienNavigation?.HoTen ?? hv.MaHocVien)"
                                                    data-ma-lop="@Model.MaLopHoc">
                                                <i class="bi bi-box-arrow-right me-1"></i>
                                                Rời lớp
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                </tr>

                                stt++;
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <div class="empty-state-icon">
                        <i class="bi bi-people"></i>
                    </div>
                    <h6 class="fw-bold">Chưa có học viên trong lớp</h6>
                    <p class="text-muted mb-3">
                        Bạn có thể xếp học viên đủ điều kiện vào lớp này.
                    </p>

                    @if (choPhepXepHocVien && soChoConLai > 0)
                    {
                        <button type="button"
                                class="btn btn-primary"
                                data-bs-toggle="modal"
                                data-bs-target="#modalXepHocVien">
                            <i class="bi bi-person-plus me-1"></i>
                            Xếp học viên ngay
                        </button>
                    }
                </div>
            }
        </div>
    </div>

    <!-- LỊCH HỌC -->
    <div class="card detail-card">
        <div class="card-header detail-card-header">
            <div>
                <h5 class="section-title mb-1">
                    <i class="bi bi-calendar-week text-success me-2"></i>
                    Lịch học của lớp
                </h5>
                <small class="text-muted">
                    Danh sách các buổi học đã được lên lịch
                </small>
            </div>

            <span class="badge rounded-pill bg-success-subtle text-success px-3 py-2">
                @(Model.LichHocs?.Count ?? 0) buổi học
            </span>
        </div>

        <div class="card-body p-0">
            @if (Model.LichHocs != null && Model.LichHocs.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle table-modern mb-0">
                        <thead>
                            <tr>
                                <th class="ps-4">Mã lịch học</th>
                                <th>Ngày học</th>
                                <th>Giờ bắt đầu</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var lich in Model.LichHocs
                                                    .OrderBy(x => x.NgayHoc)
                                                    .ThenBy(x => x.GioBatDau))
                            {
                                <tr>
                                    <td class="ps-4">
                                        <span class="code-badge">@lich.MaLichHoc</span>
                                    </td>
                                    <td>
                                        <i class="bi bi-calendar3 text-muted me-1"></i>
                                        @lich.NgayHoc.ToString("dd/MM/yyyy")
                                    </td>
                                    <td>
                                        <i class="bi bi-clock text-muted me-1"></i>
                                        @lich.GioBatDau.ToString("HH:mm")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <div class="empty-state-icon">
                        <i class="bi bi-calendar-x"></i>
                    </div>
                    <h6 class="fw-bold">Chưa có lịch học</h6>
                    <p class="text-muted mb-0">
                        Lớp học hiện chưa được tạo lịch học.
                    </p>
                </div>
            }
        </div>
    </div>
</div>

<!-- MODAL XẾP HỌC VIÊN -->
<div class="modal fade"
     id="modalXepHocVien"
     tabindex="-1"
     aria-labelledby="modalXepHocVienLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title fw-bold" id="modalXepHocVienLabel">
                        <i class="bi bi-person-plus text-primary me-2"></i>
                        Xếp học viên vào lớp
                    </h5>
                    <small class="text-muted">
                        Chỉ hiển thị học viên đủ điều kiện đăng ký lớp này
                    </small>
                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Đóng"></button>
            </div>

            <form asp-action="XepHocVien"
                  method="post"
                  id="formXepHocVien">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="maLopHoc"
                       value="@Model.MaLopHoc" />

                <div class="modal-body">
                    <div class="assignment-summary mb-3">
                        <div>
                            <div class="text-muted small">Sĩ số hiện tại</div>
                            <div class="fw-bold">@soHocVien / @siSoToiDa học viên</div>
                        </div>
                        <div>
                            <div class="text-muted small">Số chỗ còn lại</div>
                            <div class="fw-bold text-primary">@soChoConLai</div>
                        </div>
                        <div>
                            <div class="text-muted small">Đã chọn</div>
                            <div class="fw-bold" id="demHocVienChon">0 / @soChoConLai</div>
                        </div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-md-8">
                            <div class="input-group">
                                <span class="input-group-text bg-white">
                                    <i class="bi bi-search"></i>
                                </span>
                                <input type="text"
                                       class="form-control"
                                       id="timHocVienXep"
                                       placeholder="Tìm theo mã, họ tên hoặc số điện thoại..."
                                       autocomplete="off" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <button type="button"
                                    class="btn btn-light border w-100"
                                    id="btnTaiLaiHocVien">
                                <i class="bi bi-arrow-clockwise me-1"></i>
                                Tải lại danh sách
                            </button>
                        </div>
                    </div>

                    <div id="thongBaoXepHocVien" class="alert alert-info" role="status">
                        Đang tải danh sách học viên...
                    </div>

                    <div class="table-responsive assignment-table-wrap">
                        <table class="table table-hover align-middle mb-0 table-modern">
                            <thead>
                                <tr>
                                    <th class="text-center" style="width:55px;">
                                        <input type="checkbox"
                                               class="form-check-input"
                                               id="chonTatCaHocVien"
                                               aria-label="Chọn tất cả học viên đang hiển thị" />
                                    </th>
                                    <th>Mã học viên</th>
                                    <th>Họ và tên</th>
                                    <th>Số điện thoại</th>
                                </tr>
                            </thead>
                            <tbody id="danhSachHocVienXep"></tbody>
                        </table>
                    </div>

                    <div id="khongCoHocVien" class="empty-state d-none">
                        <div class="empty-state-icon">
                            <i class="bi bi-person-exclamation"></i>
                        </div>
                        <h6 class="fw-bold">Không có học viên phù hợp</h6>
                        <p class="text-muted mb-0">
                            Kiểm tra trạng thái học viên và đăng ký khóa học.
                        </p>
                    </div>

                    <div class="small text-muted mt-3">
                        <i class="bi bi-info-circle me-1"></i>
                        Máy chủ sẽ kiểm tra lại điều kiện trước khi lưu.
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-light border"
                            data-bs-dismiss="modal">
                        Hủy
                    </button>

                    <button type="submit"
                            class="btn btn-primary"
                            id="btnXacNhanXep"
                            disabled>
                        <i class="bi bi-check2-circle me-1"></i>
                        Xác nhận xếp học viên
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- SWEETALERT2 -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        // --------------------------------------------------
        // 1. THÔNG BÁO TỪ SERVER QUA TEMPDATA
        // --------------------------------------------------
        const successMessage = @Html.Raw(
                        System.Text.Json.JsonSerializer.Serialize(TempData["Success"]?.ToString())
                );

        const errorMessage = @Html.Raw(
                        System.Text.Json.JsonSerializer.Serialize(TempData["Error"]?.ToString())
                );

        const warningMessage = @Html.Raw(
                        System.Text.Json.JsonSerializer.Serialize(TempData["Warning"]?.ToString())
                );

        if (successMessage) {
            Swal.fire({
                icon: "success",
                title: "Thành công",
                text: successMessage,
                confirmButtonText: "Đóng",
                timer: 3500,
                timerProgressBar: true
            });
        } else if (errorMessage) {
            Swal.fire({
                icon: "error",
                title: "Không thể thực hiện",
                text: errorMessage,
                confirmButtonText: "Đã hiểu"
            });
        } else if (warningMessage) {
            Swal.fire({
                icon: "warning",
                title: "Lưu ý",
                text: warningMessage,
                confirmButtonText: "Đóng"
            });
        }

        // --------------------------------------------------
        // 2. XÁC NHẬN CẬP NHẬT TRẠNG THÁI LỚP
        // --------------------------------------------------
        const formChangeStatus = document.getElementById("formChangeStatus");
        const selectTrangThai = document.getElementById("selectTrangThai");
        const trangThaiHienTai = @Html.Raw(
                        System.Text.Json.JsonSerializer.Serialize(Model.TrangThai)
                );

        if (formChangeStatus && selectTrangThai) {
            formChangeStatus.addEventListener("submit", function (event) {
                event.preventDefault();

                const trangThaiMoi = selectTrangThai.value;

                if (trangThaiMoi === trangThaiHienTai) {
                    Swal.fire({
                        icon: "info",
                        title: "Không có thay đổi",
                        text: "Trạng thái lớp học đang được chọn đã giống trạng thái hiện tại.",
                        confirmButtonText: "Đóng"
                    });
                    return;
                }

                Swal.fire({
                    title: "Xác nhận cập nhật?",
                    text: "Chuyển trạng thái lớp sang \"" + trangThaiMoi + "\"?",
                    icon: "question",
                    showCancelButton: true,
                    confirmButtonText: "Xác nhận",
                    cancelButtonText: "Hủy",
                    reverseButtons: true,
                    focusCancel: true
                }).then(function (result) {
                    if (result.isConfirmed) {
                        formChangeStatus.submit();
                    }
                });
            });
        }

        // --------------------------------------------------
        // 3. XỬ LÝ MODAL XẾP HỌC VIÊN
        // --------------------------------------------------
        const modal = document.getElementById("modalXepHocVien");
        if (!modal) return;

        const tbody = document.getElementById("danhSachHocVienXep");
        const thongBao = document.getElementById("thongBaoXepHocVien");
        const khongCo = document.getElementById("khongCoHocVien");
        const timKiem = document.getElementById("timHocVienXep");
        const chonTatCa = document.getElementById("chonTatCaHocVien");
        const dem = document.getElementById("demHocVienChon");
        const nutXacNhan = document.getElementById("btnXacNhanXep");
        const nutTaiLai = document.getElementById("btnTaiLaiHocVien");
        const form = document.getElementById("formXepHocVien");

        const maLop = @Html.Raw(
                        System.Text.Json.JsonSerializer.Serialize(Model.MaLopHoc)
                );

        const soChoConLai = @soChoConLai;

        let hocViens = [];
        let dangTai = false;
        let dangGui = false;

        function hienThongBao(noiDung, loai = "info") {
            thongBao.className = "alert alert-" + loai;
            thongBao.textContent = noiDung;
            thongBao.classList.remove("d-none");
        }

        function anThongBao() {
            thongBao.classList.add("d-none");
        }

        function layCheckbox() {
            return Array.from(
                tbody.querySelectorAll('input[name="danhSachMaHocVien"]')
            );
        }

        function capNhatDem() {
            const checkboxes = layCheckbox();
            const daChon = checkboxes.filter(x => x.checked).length;

            dem.textContent = daChon + " / " + soChoConLai;

            nutXacNhan.disabled =
                dangTai ||
                dangGui ||
                daChon === 0 ||
                daChon > soChoConLai;

            const checkboxHienThi = checkboxes.filter(
                x => x.closest("tr").style.display !== "none"
            );

            chonTatCa.checked =
                checkboxHienThi.length > 0 &&
                checkboxHienThi.every(x => x.checked);

            chonTatCa.indeterminate =
                checkboxHienThi.some(x => x.checked) &&
                !checkboxHienThi.every(x => x.checked);

            chonTatCa.disabled =
                dangTai ||
                checkboxHienThi.length === 0 ||
                soChoConLai <= 0;
        }

        function taoO(noiDung) {
            const td = document.createElement("td");
            td.textContent = noiDung || "—";
            return td;
        }

        function hienThiDanhSach(ds) {
            tbody.replaceChildren();
            khongCo.classList.add("d-none");

            ds.forEach(hv => {
                const tr = document.createElement("tr");
                tr.className = "student-select-row";

                const tdCheck = document.createElement("td");
                tdCheck.className = "text-center";

                const checkbox = document.createElement("input");
                checkbox.type = "checkbox";
                checkbox.className = "form-check-input";
                checkbox.name = "danhSachMaHocVien";
                checkbox.value = hv.maHocVien;

                checkbox.addEventListener("change", function () {
                    const daChon = layCheckbox().filter(x => x.checked).length;

                    if (daChon > soChoConLai) {
                        checkbox.checked = false;

                        Swal.fire({
                            icon: "warning",
                            title: "Đã vượt quá sĩ số",
                            text: "Lớp chỉ còn " + soChoConLai + " chỗ trống.",
                            confirmButtonText: "Đã hiểu"
                        });
                    }

                    tr.classList.toggle("selected", checkbox.checked);
                    capNhatDem();
                });

                tdCheck.appendChild(checkbox);
                tr.appendChild(tdCheck);
                tr.appendChild(taoO(hv.maHocVien));
                tr.appendChild(taoO(hv.hoTen));
                tr.appendChild(taoO(hv.soDienThoai));

                tr.addEventListener("click", function (event) {
                    if (event.target.closest("input")) return;

                    checkbox.checked = !checkbox.checked;
                    checkbox.dispatchEvent(new Event("change"));
                });

                tbody.appendChild(tr);
            });

            const coHocVien = ds.length > 0;
            khongCo.classList.toggle("d-none", coHocVien);

            if (coHocVien) {
                anThongBao();
            } else {
                hienThongBao(
                    hocViens.length === 0
                        ? "Không tìm thấy học viên đủ điều kiện để xếp vào lớp."
                        : "Không tìm thấy học viên phù hợp với từ khóa.",
                    "info"
                );
            }

            capNhatDem();
        }

        function locDanhSach() {
            const tuKhoa = timKiem.value.trim().toLocaleLowerCase("vi");

            const danhSachLoc = hocViens.filter(hv => {
                const noiDung = [
                    hv.maHocVien,
                    hv.hoTen,
                    hv.soDienThoai
                ].filter(Boolean).join(" ").toLocaleLowerCase("vi");

                return noiDung.includes(tuKhoa);
            });

            hienThiDanhSach(danhSachLoc);
        }

        async function taiDanhSach() {
            if (dangTai) return;

            dangTai = true;
            tbody.replaceChildren();
            khongCo.classList.add("d-none");
            chonTatCa.checked = false;
            nutXacNhan.disabled = true;
            nutTaiLai.disabled = true;

            hienThongBao("Đang tải danh sách học viên...", "info");

            if (soChoConLai <= 0) {
                hocViens = [];
                dangTai = false;
                nutTaiLai.disabled = false;

                hienThongBao("Lớp đã đủ sĩ số tối đa.", "warning");
                capNhatDem();
                return;
            }

            try {
                const url =
                    '@Url.Action("GetHocVienCoTheXep", "LopHoc")' +
                    '?maLopHoc=' + encodeURIComponent(maLop);

                const response = await fetch(url, {
                    method: "GET",
                    headers: {
                        "Accept": "application/json"
                    }
                });

                if (!response.ok) {
                    throw new Error("Không thể tải danh sách học viên.");
                }

                const data = await response.json();

                if (!Array.isArray(data)) {
                    throw new Error("Dữ liệu trả về không đúng định dạng.");
                }

                hocViens = data;
                locDanhSach();
            } catch (error) {
                hocViens = [];
                tbody.replaceChildren();
                khongCo.classList.add("d-none");

                hienThongBao(
                    error.message || "Có lỗi khi tải danh sách học viên.",
                    "danger"
                );
            } finally {
                dangTai = false;
                nutTaiLai.disabled = false;
                capNhatDem();
            }
        }

        modal.addEventListener("show.bs.modal", function () {
            timKiem.value = "";
            hocViens = [];
            taiDanhSach();
        });

        timKiem.addEventListener("input", locDanhSach);

        nutTaiLai.addEventListener("click", function () {
            timKiem.value = "";
            taiDanhSach();
        });

        chonTatCa.addEventListener("change", function () {
            const checkboxes = layCheckbox().filter(
                x => x.closest("tr").style.display !== "none"
            );

            if (this.checked) {
                let daChon = layCheckbox().filter(x => x.checked).length;

                for (const checkbox of checkboxes) {
                    if (!checkbox.checked && daChon < soChoConLai) {
                        checkbox.checked = true;
                        checkbox.closest("tr").classList.add("selected");
                        daChon++;
                    }
                }
            } else {
                checkboxes.forEach(checkbox => {
                    checkbox.checked = false;
                    checkbox.closest("tr").classList.remove("selected");
                });
            }

            capNhatDem();
        });

        // --------------------------------------------------
        // 4. XÁC NHẬN GỬI FORM XẾP HỌC VIÊN
        // --------------------------------------------------
        form.addEventListener("submit", function (event) {
            event.preventDefault();

            if (dangGui) return;

            const daChon = layCheckbox().filter(x => x.checked).length;

            if (daChon === 0) {
                Swal.fire({
                    icon: "warning",
                    title: "Chưa chọn học viên",
                    text: "Vui lòng chọn ít nhất một học viên.",
                    confirmButtonText: "Đã hiểu"
                });
                return;
            }

            if (daChon > soChoConLai) {
                Swal.fire({
                    icon: "warning",
                    title: "Vượt quá sĩ số",
                    text: "Lớp chỉ còn " + soChoConLai + " chỗ trống.",
                    confirmButtonText: "Đã hiểu"
                });
                return;
            }

            Swal.fire({
                title: "Xác nhận xếp học viên?",
                text: "Bạn sẽ xếp " + daChon + " học viên vào lớp này.",
                icon: "question",
                showCancelButton: true,
                confirmButtonText: "Đồng ý xếp lớp",
                cancelButtonText: "Kiểm tra lại",
                reverseButtons: true,
                focusCancel: true
            }).then(function (result) {
                if (result.isConfirmed) {
                    dangGui = true;
                    nutXacNhan.disabled = true;

                    Swal.fire({
                        title: "Đang xử lý...",
                        text: "Vui lòng chờ trong giây lát.",
                        allowOutsideClick: false,
                        allowEscapeKey: false,
                        didOpen: function () {
                            Swal.showLoading();
                        }
                    });

                    // Gửi form bình thường, kèm AntiForgeryToken.
                    form.submit();
                }
            });
        });
                // --------------------------------------------------
        // 5. XÁC NHẬN VÀ XỬ LÝ HỌC VIÊN RỜI LỚP
        // --------------------------------------------------
        document.querySelectorAll(".btn-roi-lop").forEach(function (button) {
            button.addEventListener("click", async function () {
                const maHocVien = button.dataset.maHocVien;
                const hoTen = button.dataset.hoTen;
                const maLopHoc = button.dataset.maLop;

                const result = await Swal.fire({
                    title: "Xác nhận rời lớp?",
                    html:
                        '<div class="text-start">' +
                        '<p class="mb-2">Học viên: <strong>' +
                        escapeHtml(hoTen) +
                        '</strong></p>' +
                        '<p class="text-muted small mb-3">' +
                        'Học viên sẽ được chuyển sang trạng thái đã rời lớp. ' +
                        'Lịch sử tham gia lớp vẫn được lưu.' +
                        '</p>' +
                        '</div>',
                    input: "textarea",
                    inputLabel: "Lý do rời lớp",
                    inputPlaceholder: "Nhập lý do rời lớp...",
                    inputAttributes: {
                        maxlength: 500,
                        "aria-label": "Lý do rời lớp"
                    },
                    inputValidator: function (value) {
                        if (!value || !value.trim()) {
                            return "Vui lòng nhập lý do rời lớp.";
                        }

                        if (value.trim().length > 500) {
                            return "Lý do không được vượt quá 500 ký tự.";
                        }

                        return undefined;
                    },
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonText: "Xác nhận rời lớp",
                    cancelButtonText: "Hủy",
                    confirmButtonColor: "#dc3545",
                    reverseButtons: true,
                    focusCancel: true
                });

                if (!result.isConfirmed) {
                    return;
                }

                // Lấy AntiForgeryToken từ form xếp học viên.
                const tokenInput = document.querySelector(
                    '#formXepHocVien input[name="__RequestVerificationToken"]'
                );

                if (!tokenInput) {
                    await Swal.fire({
                        icon: "error",
                        title: "Không thể thực hiện",
                        text: "Không tìm thấy mã xác thực bảo mật. Vui lòng tải lại trang."
                    });
                    return;
                }

                // Tạo form POST để gửi dữ liệu về controller.
                const postForm = document.createElement("form");
                postForm.method = "POST";
                postForm.action = '@Url.Action("RoiLop", "LopHoc")';
                postForm.style.display = "none";

                const fields = {
                    maLopHoc: maLopHoc,
                    maHocVien: maHocVien,
                    lyDoRaLop: result.value.trim(),
                    __RequestVerificationToken: tokenInput.value
                };

                Object.entries(fields).forEach(function ([name, value]) {
                    const input = document.createElement("input");
                    input.type = "hidden";
                    input.name = name;
                    input.value = value;
                    postForm.appendChild(input);
                });

                document.body.appendChild(postForm);

                Swal.fire({
                    title: "Đang xử lý...",
                    text: "Đang cập nhật thông tin học viên.",
                    allowOutsideClick: false,
                    allowEscapeKey: false,
                    didOpen: function () {
                        Swal.showLoading();
                    }
                });

                postForm.submit();
            });
        });

        // Mã hóa nội dung hiển thị trong HTML của SweetAlert2.
        function escapeHtml(value) {
            const div = document.createElement("div");
            div.textContent = value ?? "";
            return div.innerHTML;
        }
    });
</script>
