@model TTDaoTaoLaiXe.Models.KhoaHoc

@{
    ViewData["Title"] = "Thêm khóa học";
}

<div class="container-fluid">

    <!-- =========================
         HEADER
    ========================== -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h4 class="fw-bold mb-1">
                <i class="bi bi-journal-plus me-2"></i>
                Thêm khóa học
            </h4>

            <div class="text-muted">
                Tạo thông tin khóa học đào tạo lái xe mới
            </div>
        </div>

        <a asp-action="Index"
           class="btn btn-light border">

            <i class="bi bi-arrow-left me-1"></i>
            Quay lại

        </a>

    </div>


    <!-- =========================
         FORM
    ========================== -->
    <div class="card border-0 shadow-sm">
        @* <div asp-validation-summary="All"
             class="alert alert-danger">
        </div> *@
        <div class="card-body p-4">

            <form asp-controller="KhoaHoc"
                  asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()


                <!-- =========================
                     VALIDATION TỔNG
                ========================== -->
                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"
                     role="alert">
                </div>


                <div class="row g-4">


                    <!-- =========================
                         MÃ KHÓA HỌC
                    ========================== -->
                    <div class="col-md-6">

                        <label asp-for="MaKhoaHoc"
                               class="form-label fw-semibold">

                            Mã khóa học
                            <span class="text-danger">*</span>

                        </label>

                        <input asp-for="MaKhoaHoc"
                               class="form-control"
                               placeholder="Ví dụ: KH001"
                               autocomplete="off" />

                        <span asp-validation-for="MaKhoaHoc"
                              class="text-danger small">
                        </span>

                        <div class="form-text">
                            Mã khóa học phải là duy nhất.
                        </div>

                    </div>


                    <!-- =========================
                         TÊN KHÓA HỌC
                    ========================== -->
                    <div class="col-md-6">

                        <label asp-for="TenKhoaHoc"
                               class="form-label fw-semibold">

                            Tên khóa học
                            <span class="text-danger">*</span>

                        </label>

                        <input asp-for="TenKhoaHoc"
                               class="form-control"
                               placeholder="Ví dụ: Đào tạo lái xe hạng B"
                               autocomplete="off" />

                        <span asp-validation-for="TenKhoaHoc"
                              class="text-danger small">
                        </span>

                        <div class="form-text">
                            Tên khóa học không được trùng.
                        </div>

                    </div>


                    <!-- =========================
                         HẠNG GPLX
                    ========================== -->
                    <div class="col-md-6">

                        <label asp-for="HangGplx"
                               class="form-label fw-semibold">

                            Hạng GPLX
                            <span class="text-danger">*</span>

                        </label>

                        <select asp-for="HangGplx"
                                class="form-select">

                            <option value="">
                                -- Chọn hạng GPLX --
                            </option>

                            @if (ViewBag.HangGplxes != null)
                            {
                                foreach (var hang in ViewBag.HangGplxes)
                                {
                                    <option value="@hang.MaHang">
                                        @hang.MaHang - @hang.TenHang
                                    </option>
                                }
                            }

                        </select>

                        <span asp-validation-for="HangGplx"
                              class="text-danger small">
                        </span>

                        <div class="form-text">
                            Chỉ hiển thị các hạng GPLX đang hoạt động.
                        </div>

                    </div>


                    <!-- =========================
                         THỜI GIAN ĐÀO TẠO
                    ========================== -->
                    <div class="col-md-6">

                        <label asp-for="ThoiGianDaoTao"
                               class="form-label fw-semibold">

                            Tổng thời gian đào tạo
                            <span class="text-danger">*</span>

                        </label>

                        <div class="input-group">

                            <input asp-for="ThoiGianDaoTao"
                                   type="number"
                                   min="1"
                                   class="form-control"
                                   placeholder="Ví dụ: 90" />

                            <span class="input-group-text">
                                giờ
                            </span>

                        </div>

                        <span asp-validation-for="ThoiGianDaoTao"
                              class="text-danger small">
                        </span>

                    </div>


                    <!-- =========================
                         GIỜ LÝ THUYẾT
                    ========================== -->
                    <div class="col-md-4">

                        <label asp-for="SoGioLyThuyet"
                               class="form-label fw-semibold">

                            Số giờ lý thuyết

                        </label>

                        <div class="input-group">

                            <input asp-for="SoGioLyThuyet"
                                   type="number"
                                   min="0"
                                   class="form-control"
                                   placeholder="0" />

                            <span class="input-group-text">
                                giờ
                            </span>

                        </div>

                        <span asp-validation-for="SoGioLyThuyet"
                              class="text-danger small">
                        </span>

                    </div>


                    <!-- =========================
                         GIỜ THỰC HÀNH
                    ========================== -->
                    <div class="col-md-4">

                        <label asp-for="SoGioThucHanh"
                               class="form-label fw-semibold">

                            Số giờ thực hành

                        </label>

                        <div class="input-group">

                            <input asp-for="SoGioThucHanh"
                                   type="number"
                                   min="0"
                                   class="form-control"
                                   placeholder="0" />

                            <span class="input-group-text">
                                giờ
                            </span>

                        </div>

                        <span asp-validation-for="SoGioThucHanh"
                              class="text-danger small">
                        </span>

                    </div>


                    <!-- =========================
                         GIỜ DAT
                    ========================== -->
                    <div class="col-md-4">

                        <label asp-for="SoGioDat"
                               class="form-label fw-semibold">

                            Số giờ DAT

                        </label>

                        <div class="input-group">

                            <input asp-for="SoGioDat"
                                   type="number"
                                   min="0"
                                   class="form-control"
                                   placeholder="0" />

                            <span class="input-group-text">
                                giờ
                            </span>

                        </div>

                        <span asp-validation-for="SoGioDat"
                              class="text-danger small">
                        </span>

                    </div>


                    <!-- =========================
                         NGÀY BẮT ĐẦU
                    ========================== -->
                    <div class="col-md-6">

                        <label asp-for="NgayBatDau"
                               class="form-label fw-semibold">

                            Ngày bắt đầu

                        </label>

                        <input asp-for="NgayBatDau"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="NgayBatDau"
                              class="text-danger small">
                        </span>

                    </div>


                    <!-- =========================
                         NGÀY KẾT THÚC
                    ========================== -->
                    <div class="col-md-6">

                        <label asp-for="NgayKetThuc"
                               class="form-label fw-semibold">

                            Ngày kết thúc

                        </label>

                        <input asp-for="NgayKetThuc"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="NgayKetThuc"
                              class="text-danger small">
                        </span>

                    </div>


                    <!-- =========================
                         MÔ TẢ
                    ========================== -->
                    <div class="col-12">

                        <label asp-for="MoTa"
                               class="form-label fw-semibold">

                            Mô tả

                        </label>

                        <textarea asp-for="MoTa"
                                  class="form-control"
                                  rows="4"
                                  maxlength="500"
                                  placeholder="Nhập mô tả về khóa học..."></textarea>

                        <span asp-validation-for="MoTa"
                              class="text-danger small">
                        </span>

                        <div class="form-text">
                            Tối đa 500 ký tự.
                        </div>

                    </div>


                    <!-- =========================
                         TRẠNG THÁI
                    ========================== -->
                    <div class="col-12">

                        <div class="alert alert-info mb-0">

                            <div class="d-flex">

                                <i class="bi bi-info-circle-fill me-2 mt-1"></i>

                                <div>

                                    <strong>Trạng thái khóa học</strong>

                                    <div class="mt-1">
                                        Khóa học mới sẽ mặc định ở trạng thái
                                        <strong>Đang hoạt động</strong>.
                                    </div>

                                    <div class="mt-1">
                                        Sau khi tạo, trạng thái có thể được
                                        bật/tắt bằng công tắc tại danh sách
                                        khóa học.
                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- =========================
                     BUTTON
                ========================== -->
                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">

                    <a asp-action="Index"
                       class="btn btn-light border">

                        <i class="bi bi-x-lg me-1"></i>
                        Hủy

                    </a>

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-check-lg me-1"></i>
                        Thêm khóa học

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}