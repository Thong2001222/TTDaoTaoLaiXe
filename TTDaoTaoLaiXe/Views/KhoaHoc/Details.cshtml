@model TTDaoTaoLaiXe.Models.KhoaHoc

@{
    ViewData["Title"] = "Chi tiết khóa học";

    var tongGio =
        Model.SoGioLyThuyet +
        Model.SoGioThucHanh +
        Model.SoGioDat;

    var tyLeLyThuyet = Model.ThoiGianDaoTao > 0
        ? (double)Model.SoGioLyThuyet / Model.ThoiGianDaoTao * 100
        : 0;

    var tyLeThucHanh = Model.ThoiGianDaoTao > 0
        ? (double)Model.SoGioThucHanh / Model.ThoiGianDaoTao * 100
        : 0;

    var tyLeDat = Model.ThoiGianDaoTao > 0
        ? (double)Model.SoGioDat / Model.ThoiGianDaoTao * 100
        : 0;
}


<div class="container-fluid">


    <!-- =====================================================
         HEADER
    ====================================================== -->

    <div class="d-flex flex-wrap justify-content-between
                align-items-center gap-3 mb-4">

        <div>

            <div class="d-flex align-items-center gap-2 mb-2">

                <a asp-action="Index"
                   class="text-decoration-none text-muted">

                    <i class="bi bi-arrow-left"></i>
                    Khóa học

                </a>

                <span class="text-muted">/</span>

                <span class="text-muted">
                    Chi tiết
                </span>

            </div>


            <div class="d-flex align-items-center gap-3">

                <div class="rounded-3 bg-primary bg-opacity-10
                            text-primary d-flex align-items-center
                            justify-content-center"
                     style="width:52px;height:52px;">

                    <i class="bi bi-journal-text fs-4"></i>

                </div>


                <div>

                    <h3 class="fw-bold mb-1">
                        @Model.TenKhoaHoc
                    </h3>

                    <div class="text-muted">

                        Mã khóa học:
                        <strong class="text-dark">
                            @Model.MaKhoaHoc
                        </strong>

                    </div>

                </div>

            </div>

        </div>


        <!-- ACTIONS -->

        <div class="d-flex gap-2">

            <a asp-action="Index"
               class="btn btn-light border">

                <i class="bi bi-arrow-left me-1"></i>
                Quay lại

            </a>


            <button type="button"
                    class="btn btn-primary"
                    onclick="openEditModal('@Model.MaKhoaHoc')">

                <i class="bi bi-pencil-square me-1"></i>
                Chỉnh sửa

            </button>

        </div>

    </div>



    <!-- =====================================================
         STATUS
    ====================================================== -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body p-4">

            <div class="d-flex flex-wrap
                        justify-content-between
                        align-items-center gap-3">

                <div>

                    <div class="text-muted small mb-1">
                        Trạng thái khóa học
                    </div>

                    @if (Model.TrangThai)
                    {
                        <span class="badge bg-success-subtle
                                         text-success px-3 py-2">

                            <i class="bi bi-check-circle-fill me-1"></i>
                            Đang hoạt động

                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary-subtle
                                         text-secondary px-3 py-2">

                            <i class="bi bi-pause-circle-fill me-1"></i>
                            Ngừng hoạt động

                        </span>
                    }

                </div>


                <div class="text-end">

                    <div class="text-muted small">
                        Hạng GPLX
                    </div>

                    <div class="fw-bold fs-5">

                        @if (Model.HangGplxNavigation != null)
                        {
                            @Model.HangGplxNavigation.MaHang
                            <span class="fw-normal">
                                -
                                @Model.HangGplxNavigation.TenHang
                            </span>
                        }
                        else
                        {
                            <span class="text-muted">
                                Chưa xác định
                            </span>
                        }

                    </div>

                </div>

            </div>

        </div>

    </div>



    <!-- =====================================================
         KPI
    ====================================================== -->

    <div class="row g-3 mb-4">


        <!-- Tổng thời gian -->

        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex
                                justify-content-between
                                align-items-start">

                        <div>

                            <div class="text-muted small">
                                Tổng thời gian
                            </div>

                            <div class="fs-3 fw-bold mt-1">
                                @Model.ThoiGianDaoTao
                                <span class="fs-6 fw-normal text-muted">
                                    giờ
                                </span>
                            </div>

                        </div>

                        <div class="text-primary
                                    bg-primary bg-opacity-10
                                    rounded-3 p-3">

                            <i class="bi bi-clock fs-5"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Lý thuyết -->

        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex
                                justify-content-between
                                align-items-start">

                        <div>

                            <div class="text-muted small">
                                Lý thuyết
                            </div>

                            <div class="fs-3 fw-bold mt-1">
                                @Model.SoGioLyThuyet
                                <span class="fs-6 fw-normal text-muted">
                                    giờ
                                </span>
                            </div>

                        </div>

                        <div class="text-info
                                    bg-info bg-opacity-10
                                    rounded-3 p-3">

                            <i class="bi bi-book fs-5"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Thực hành -->

        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex
                                justify-content-between
                                align-items-start">

                        <div>

                            <div class="text-muted small">
                                Thực hành
                            </div>

                            <div class="fs-3 fw-bold mt-1">
                                @Model.SoGioThucHanh
                                <span class="fs-6 fw-normal text-muted">
                                    giờ
                                </span>
                            </div>

                        </div>

                        <div class="text-warning
                                    bg-warning bg-opacity-10
                                    rounded-3 p-3">

                            <i class="bi bi-car-front fs-5"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- DAT -->

        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex
                                justify-content-between
                                align-items-start">

                        <div>

                            <div class="text-muted small">
                                DAT
                            </div>

                            <div class="fs-3 fw-bold mt-1">
                                @Model.SoGioDat
                                <span class="fs-6 fw-normal text-muted">
                                    giờ
                                </span>
                            </div>

                        </div>

                        <div class="text-success
                                    bg-success bg-opacity-10
                                    rounded-3 p-3">

                            <i class="bi bi-pc-display fs-5"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>



    <div class="row g-4">


        <!-- =====================================================
             THÔNG TIN KHÓA HỌC
        ====================================================== -->

        <div class="col-lg-8">

            <div class="card border-0 shadow-sm mb-4">

                <div class="card-header bg-white border-0 pt-4 px-4">

                    <h5 class="fw-bold mb-1">
                        <i class="bi bi-info-circle me-2 text-primary"></i>
                        Thông tin khóa học
                    </h5>

                    <div class="text-muted small">
                        Thông tin cấu hình và thời gian đào tạo
                    </div>

                </div>


                <div class="card-body px-4">

                    <div class="row g-4">


                        <div class="col-md-6">

                            <div class="text-muted small mb-1">
                                Mã khóa học
                            </div>

                            <div class="fw-semibold">
                                @Model.MaKhoaHoc
                            </div>

                        </div>


                        <div class="col-md-6">

                            <div class="text-muted small mb-1">
                                Tên khóa học
                            </div>

                            <div class="fw-semibold">
                                @Model.TenKhoaHoc
                            </div>

                        </div>


                        <div class="col-md-6">

                            <div class="text-muted small mb-1">
                                Hạng giấy phép lái xe
                            </div>

                            <div class="fw-semibold">

                                @if (Model.HangGplxNavigation != null)
                                {
                                    @Model.HangGplxNavigation.MaHang
                                    @: -
                                    @Model.HangGplxNavigation.TenHang
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Chưa xác định
                                    </span>
                                }

                            </div>

                        </div>


                        <div class="col-md-6">

                            <div class="text-muted small mb-1">
                                Loại hộp số
                            </div>

                            <div class="fw-semibold">

                                @(Model.HangGplxNavigation?.LoaiHopSo
                                                                ?? "Chưa cập nhật")

                            </div>

                        </div>


                        <div class="col-md-6">

                            <div class="text-muted small mb-1">
                                Ngày bắt đầu
                            </div>

                            <div class="fw-semibold">

                                @if (Model.NgayBatDau.HasValue)
                                {
                                    @Model.NgayBatDau.Value.ToString("dd/MM/yyyy")
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Chưa xác định
                                    </span>
                                }

                            </div>

                        </div>


                        <div class="col-md-6">

                            <div class="text-muted small mb-1">
                                Ngày kết thúc
                            </div>

                            <div class="fw-semibold">

                                @if (Model.NgayKetThuc.HasValue)
                                {
                                    @Model.NgayKetThuc.Value.ToString("dd/MM/yyyy")
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Chưa xác định
                                    </span>
                                }

                            </div>

                        </div>


                    </div>

                </div>

            </div>



            <!-- =================================================
                 PHÂN BỔ THỜI GIAN
            ================================================== -->

            <div class="card border-0 shadow-sm mb-4">

                <div class="card-header bg-white border-0 pt-4 px-4">

                    <h5 class="fw-bold mb-1">
                        <i class="bi bi-bar-chart me-2 text-primary"></i>
                        Phân bổ thời gian đào tạo
                    </h5>

                    <div class="text-muted small">
                        Cơ cấu thời lượng của khóa học
                    </div>

                </div>


                <div class="card-body px-4">


                    <!-- Lý thuyết -->

                    <div class="mb-4">

                        <div class="d-flex justify-content-between mb-2">

                            <span class="fw-semibold">
                                Lý thuyết
                            </span>

                            <span class="text-muted">
                                @Model.SoGioLyThuyet / @Model.ThoiGianDaoTao giờ
                            </span>

                        </div>

                        <div class="progress"
                             style="height:8px;">

                            <div class="progress-bar"
                                 role="progressbar"
                                 style="width:@Math.Min(tyLeLyThuyet, 100).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%">
                            </div>

                        </div>

                    </div>


                    <!-- Thực hành -->

                    <div class="mb-4">

                        <div class="d-flex justify-content-between mb-2">

                            <span class="fw-semibold">
                                Thực hành
                            </span>

                            <span class="text-muted">
                                @Model.SoGioThucHanh / @Model.ThoiGianDaoTao giờ
                            </span>

                        </div>

                        <div class="progress"
                             style="height:8px;">

                            <div class="progress-bar bg-warning"
                                 role="progressbar"
                                 style="width:@Math.Min(tyLeThucHanh, 100).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%">
                            </div>

                        </div>

                    </div>


                    <!-- DAT -->

                    <div>

                        <div class="d-flex justify-content-between mb-2">

                            <span class="fw-semibold">
                                DAT
                            </span>

                            <span class="text-muted">
                                @Model.SoGioDat / @Model.ThoiGianDaoTao giờ
                            </span>

                        </div>

                        <div class="progress"
                             style="height:8px;">

                            <div class="progress-bar bg-success"
                                 role="progressbar"
                                 style="width:@Math.Min(tyLeDat, 100).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%">
                            </div>

                        </div>

                    </div>


                    <div class="border-top mt-4 pt-3">

                        <div class="d-flex justify-content-between">

                            <span class="text-muted">
                                Tổng các nội dung
                            </span>

                            <strong>
                                @tongGio giờ
                            </strong>

                        </div>

                    </div>

                </div>

            </div>



            <!-- =================================================
                 MÔ TẢ
            ================================================== -->

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white border-0 pt-4 px-4">

                    <h5 class="fw-bold mb-1">
                        <i class="bi bi-file-text me-2 text-primary"></i>
                        Mô tả
                    </h5>

                </div>


                <div class="card-body px-4">

                    @if (!string.IsNullOrWhiteSpace(Model.MoTa))
                    {
                        <div class="text-muted"
                             style="white-space:pre-line;">

                            @Model.MoTa

                        </div>
                    }
                    else
                    {
                        <div class="text-muted fst-italic">
                            Chưa có mô tả cho khóa học này.
                        </div>
                    }

                </div>

            </div>

        </div>



        <!-- =====================================================
             CỘT PHẢI - NGHIỆP VỤ
        ====================================================== -->

        <div class="col-lg-4">


            <!-- Tổng quan nghiệp vụ -->

            <div class="card border-0 shadow-sm mb-4">

                <div class="card-header bg-white border-0 pt-4 px-4">

                    <h5 class="fw-bold mb-1">
                        <i class="bi bi-diagram-3 me-2 text-primary"></i>
                        Tổng quan nghiệp vụ
                    </h5>

                    <div class="text-muted small">
                        Dữ liệu đang liên kết với khóa học
                    </div>

                </div>


                <div class="card-body px-4">


                    <!-- Đăng ký -->

                    <div class="d-flex
                                justify-content-between
                                align-items-center
                                py-3 border-bottom">

                        <div>

                            <div class="fw-semibold">
                                Đăng ký học
                            </div>

                            <div class="text-muted small">
                                Học viên đăng ký khóa học
                            </div>

                        </div>

                        <span class="badge bg-primary-subtle text-primary
                                     rounded-pill px-3 py-2">

                            @Model.DangKyHocs.Count

                        </span>

                    </div>


                    <!-- Lớp học -->

                    <div class="d-flex
                                justify-content-between
                                align-items-center
                                py-3 border-bottom">

                        <div>

                            <div class="fw-semibold">
                                Lớp học
                            </div>

                            <div class="text-muted small">
                                Các lớp thuộc khóa học
                            </div>

                        </div>

                        <span class="badge bg-success-subtle text-success
                                     rounded-pill px-3 py-2">

                            @Model.LopHocs.Count

                        </span>

                    </div>


                    <!-- Môn học -->

                    <div class="d-flex
                                justify-content-between
                                align-items-center
                                py-3">

                        <div>

                            <div class="fw-semibold">
                                Môn học
                            </div>

                            <div class="text-muted small">
                                Môn học thuộc chương trình
                            </div>

                        </div>

                        <span class="badge bg-info-subtle text-info
                                     rounded-pill px-3 py-2">

                            @Model.KhoaHocMonHocs.Count

                        </span>

                    </div>

                </div>

            </div>



            <!-- Hạng GPLX -->

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white border-0 pt-4 px-4">

                    <h5 class="fw-bold mb-1">
                        <i class="bi bi-card-checklist me-2 text-primary"></i>
                        Hạng GPLX
                    </h5>

                </div>


                <div class="card-body px-4">

                    @if (Model.HangGplxNavigation != null)
                    {
                        <div class="rounded-3
                                        bg-light
                                        p-3">

                            <div class="text-muted small mb-1">
                                Mã hạng
                            </div>

                            <div class="fs-4 fw-bold">
                                @Model.HangGplxNavigation.MaHang
                            </div>

                            <div class="mt-2">

                                @Model.HangGplxNavigation.TenHang

                            </div>

                            @if (!string.IsNullOrWhiteSpace(
                                                    Model.HangGplxNavigation.LoaiHopSo))
                            {
                                <div class="mt-2 text-muted small">

                                    <i class="bi bi-gear me-1"></i>

                                    @Model.HangGplxNavigation.LoaiHopSo

                                </div>
                            }

                        </div>
                    }
                    else
                    {
                        <div class="text-muted">
                            Không có thông tin hạng GPLX.
                        </div>
                    }

                </div>

            </div>

        </div>

    </div>

</div>



<!-- =====================================================
     MODAL EDIT
====================================================== -->

<div class="modal fade"
     id="editKhoaHocModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content"
             id="editKhoaHocModalContent">
        </div>

    </div>

</div>



@section Scripts {

    <script>

        async function openEditModal(id) {

            const modalElement =
                document.getElementById("editKhoaHocModal");

            const content =
                document.getElementById("editKhoaHocModalContent");

            content.innerHTML = `
                <div class="modal-body text-center py-5">
                    <div class="spinner-border text-primary mb-3"></div>
                    <div class="text-muted">
                        Đang tải thông tin...
                    </div>
                </div>
            `;

            const modal =
                bootstrap.Modal.getOrCreateInstance(modalElement);

            modal.show();


            try {

                const response =
                    await fetch(
                        `/KhoaHoc/GetEdit?id=${encodeURIComponent(id)}`
                    );

                if (!response.ok) {
                    throw new Error("Không thể tải dữ liệu.");
                }

                const html =
                    await response.text();

                content.innerHTML = html;

            }
            catch (error) {

                content.innerHTML = `
                    <div class="modal-body">
                        <div class="alert alert-danger mb-0">
                            <i class="bi bi-exclamation-triangle me-2"></i>
                            Không thể tải thông tin khóa học.
                        </div>
                    </div>
                `;

            }

        }

    </script>

}