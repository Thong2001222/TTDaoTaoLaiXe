@model TTDaoTaoLaiXe.Models.DangKyHoc

@{
    ViewData["Title"] = "Đăng ký học";
}

<div class="container-fluid">

    <!-- Tiêu đề -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-person-plus"></i>
                Đăng ký học
            </h2>

            <p class="text-muted mb-0">
                Tạo đăng ký khóa học cho học viên
            </p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i>
            Quay lại
        </a>

    </div>


    <!-- Form -->
    <div class="card border-0 shadow-sm">

        <div class="card-body p-4">

            <form asp-action="Create" method="post">

                @Html.AntiForgeryToken()

                <div class="row g-4">

                    <!-- Mã đăng ký -->
                    <div class="col-md-6">

                        <label asp-for="MaDangKy"
                               class="form-label fw-semibold">
                            Mã đăng ký <span class="text-danger">*</span>
                        </label>

                        <input asp-for="MaDangKy"
                               class="form-control"
                               placeholder="Ví dụ: DK0003" />

                        <span asp-validation-for="MaDangKy"
                              class="text-danger small">
                        </span>

                    </div>


                    <!-- Ngày đăng ký -->
                    <div class="col-md-6">

                        <label asp-for="NgayDangKy"
                               class="form-label fw-semibold">
                            Ngày đăng ký <span class="text-danger">*</span>
                        </label>

                        <input asp-for="NgayDangKy"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="NgayDangKy"
                              class="text-danger small">
                        </span>

                    </div>


                    <!-- Học viên -->
                    <div class="col-md-6">

                        <label asp-for="MaHocVien"
                               class="form-label fw-semibold">
                            Học viên <span class="text-danger">*</span>
                        </label>

                        <select asp-for="MaHocVien"
                                class="form-select"
                                asp-items="ViewBag.MaHocVien">

                            <option value="">
                                -- Chọn học viên --
                            </option>

                        </select>

                        <span asp-validation-for="MaHocVien"
                              class="text-danger small">
                        </span>

                    </div>


                    <!-- Khóa học -->
                    <div class="col-md-6">

                        <label asp-for="MaKhoaHoc"
                               class="form-label fw-semibold">
                            Khóa học <span class="text-danger">*</span>
                        </label>

                        <select asp-for="MaKhoaHoc"
                                class="form-select"
                                asp-items="ViewBag.MaKhoaHoc">

                            <option value="">
                                -- Chọn khóa học --
                            </option>

                        </select>

                        <span asp-validation-for="MaKhoaHoc"
                              class="text-danger small">
                        </span>

                    </div>


                    <!-- Học phí -->
                    <div class="col-md-6">

                        <label asp-for="HocPhi"
                               class="form-label fw-semibold">
                            Học phí <span class="text-danger">*</span>
                        </label>

                        <div class="input-group">

                            <input asp-for="HocPhi"
                                   type="number"
                                   min="0"
                                   step="1000"
                                   class="form-control"
                                   placeholder="Nhập học phí" />

                            <span class="input-group-text">
                                VNĐ
                            </span>

                        </div>

                        <span asp-validation-for="HocPhi"
                              class="text-danger small">
                        </span>

                    </div>


                    <!-- Trạng thái -->
                    <div class="col-md-6">

                        <label class="form-label fw-semibold">
                            Trạng thái
                        </label>

                        <input type="text"
                               class="form-control"
                               value="Đang học"
                               readonly />

                        <div class="form-text">
                            Hệ thống tự động thiết lập trạng thái
                            khi đăng ký.
                        </div>

                    </div>


                    <!-- Ghi chú -->
                    <div class="col-12">

                        <label asp-for="GhiChu"
                               class="form-label fw-semibold">
                            Ghi chú
                        </label>

                        <textarea asp-for="GhiChu"
                                  class="form-control"
                                  rows="4"
                                  maxlength="500"
                                  placeholder="Nhập ghi chú nếu có..."></textarea>

                        <span asp-validation-for="GhiChu"
                              class="text-danger small">
                        </span>

                    </div>

                </div>


                <!-- Nút -->
                <div class="d-flex justify-content-end gap-2 mt-4">

                    <a asp-action="Index"
                       class="btn btn-light border">

                        <i class="bi bi-x-lg"></i>
                        Hủy

                    </a>

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-check-lg"></i>
                        Lưu đăng ký

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}