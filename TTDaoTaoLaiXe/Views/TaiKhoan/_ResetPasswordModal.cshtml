@model TTDaoTaoLaiXe.ViewModels.Account.TaiKhoanResetPasswordViewModel

<div class="modal-header">
    <div>
        <h5 class="modal-title fw-bold">
            <i class="bi bi-key me-2 text-warning"></i>
            Đặt lại mật khẩu
        </h5>
        <div class="small text-secondary mt-1">
            Tài khoản: <strong>@ViewBag.TenDangNhap</strong>
            — @ViewBag.HoTen
        </div>
    </div>
    <button type="button" class="btn-close"
            data-bs-dismiss="modal" aria-label="Đóng"></button>
</div>

<form id="formResetPassword"
      asp-controller="TaiKhoan"
      asp-action="ResetPassword"
      method="post">

    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="MaTaiKhoan" />

    <div class="modal-body">
        <div asp-validation-summary="ModelOnly"
             class="text-danger small mb-3"></div>

        <div class="mb-3">
            <label asp-for="MatKhauMoi" class="form-label">
                Mật khẩu mới
            </label>
            <input asp-for="MatKhauMoi"
                   type="password"
                   class="form-control"
                   autocomplete="new-password"
                   placeholder="Nhập mật khẩu mới" />
            <span asp-validation-for="MatKhauMoi"
                  class="text-danger small"></span>
        </div>

        <div class="mb-2">
            <label asp-for="XacNhanMatKhau" class="form-label">
                Xác nhận mật khẩu
            </label>
            <input asp-for="XacNhanMatKhau"
                   type="password"
                   class="form-control"
                   autocomplete="new-password"
                   placeholder="Nhập lại mật khẩu mới" />
            <span asp-validation-for="XacNhanMatKhau"
                  class="text-danger small"></span>
        </div>
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary"
                data-bs-dismiss="modal">
            Hủy
        </button>
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-check-lg me-1"></i>
            Cập nhật mật khẩu
        </button>
    </div>
</form>