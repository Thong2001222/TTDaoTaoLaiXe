@model TTDaoTaoLaiXe.ViewModels.Account.TaiKhoanResetPasswordViewModel

@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}

<div class="container py-4" style="max-width: 650px;">
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3">
            <h4 class="mb-0 fw-bold">
                <i class="bi bi-key me-2 text-warning"></i>
                Đặt lại mật khẩu
            </h4>
        </div>

        <div class="card-body p-4">
            <form asp-controller="TaiKhoan"
                  asp-action="ResetPassword"
                  asp-route-id="@Model.MaTaiKhoan"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="MaTaiKhoan" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="MatKhauMoi" class="form-label">
                        Mật khẩu mới
                    </label>
                    <input asp-for="MatKhauMoi"
                           type="password"
                           class="form-control"
                           autocomplete="new-password"
                           placeholder="Nhập mật khẩu mới" />
                    <span asp-validation-for="MatKhauMoi"
                          class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="XacNhanMatKhau" class="form-label">
                        Xác nhận mật khẩu mới
                    </label>
                    <input asp-for="XacNhanMatKhau"
                           type="password"
                           class="form-control"
                           autocomplete="new-password"
                           placeholder="Nhập lại mật khẩu mới" />
                    <span asp-validation-for="XacNhanMatKhau"
                          class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Quay lại
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg me-1"></i>
                        Cập nhật mật khẩu
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}