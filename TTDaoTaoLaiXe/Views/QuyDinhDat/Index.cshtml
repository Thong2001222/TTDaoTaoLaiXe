
@model IEnumerable<TTDaoTaoLaiXe.Models.QuyDinhDat>

@{
    ViewData["Title"] = "Quản lý quy định DAT";

    var tuKhoa = ViewBag.TuKhoa as string ?? "";
    int page = ViewBag.Page ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalItems = ViewBag.TotalItems ?? 0;

    var hangGplxes = ViewBag.HangGplxes
        as IEnumerable<TTDaoTaoLaiXe.Models.HangGplx>
        ?? Enumerable.Empty<TTDaoTaoLaiXe.Models.HangGplx>();
}

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h3 class="fw-bold mb-1">
                <i class="bi bi-speedometer2 me-2 text-primary"></i>
                Quản lý quy định DAT
            </h3>
            <div class="text-secondary">
                Thiết lập chỉ tiêu quãng đường và thời gian thực hành theo hạng GPLX.
            </div>
        </div>

        <button type="button" class="btn btn-primary"
                onclick="moModalThem()">
            <i class="bi bi-plus-lg me-1"></i> Thêm quy định
        </button>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form method="get" asp-controller="QuyDinhDat" asp-action="Index"
                  class="row g-2 align-items-center">
                <div class="col-12 col-md-6 col-lg-5">
                    <div class="input-group">
                        <span class="input-group-text bg-white">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" name="tuKhoa" value="@tuKhoa"
                               class="form-control"
                               placeholder="Tìm mã quy định, mã hạng hoặc tên hạng..." />
                    </div>
                </div>

                <div class="col-auto">
                    <button type="submit" class="btn btn-primary">
                        Tìm kiếm
                    </button>
                    <a asp-controller="QuyDinhDat" asp-action="Index"
                       class="btn btn-outline-secondary">
                        Làm mới
                    </a>
                </div>

                <div class="col-12 col-md text-md-end text-secondary small">
                    Tổng cộng <strong>@totalItems</strong> quy định
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">STT</th>
                        <th>Mã quy định</th>
                        <th>Hạng GPLX</th>
                        <th class="text-end">Tổng km</th>
                        <th class="text-end">Giờ tự động</th>
                        <th class="text-end">Giờ ban đêm</th>
                        <th class="text-center">Trạng thái</th>
                        <th class="text-center" style="min-width: 150px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        int stt = (page - 1) * 10 + 1;

                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-3">@(stt++)</td>
                                <td>
                                    <span class="fw-semibold">
                                        @item.MaQuyDinhDat
                                    </span>
                                </td>
                                <td>
                                    <div class="fw-semibold">
                                        @(item.MaHangNavigation?.TenHang ?? item.MaHang)
                                    </div>
                                    <small class="text-secondary">
                                        @item.MaHang
                                        @if (!string.IsNullOrWhiteSpace(item.MaHangNavigation?.LoaiHopSo))
                                        {
                                            <span> · @item.MaHangNavigation.LoaiHopSo</span>
                                        }
                                    </small>
                                </td>
                                <td class="text-end">
                                    @item.TongKm.ToString("N2")
                                </td>
                                <td class="text-end">
                                    @item.SoGioTuDong.ToString("N2")
                                </td>
                                <td class="text-end">
                                    @item.SoGioBanDem.ToString("N2")
                                </td>
                                <td class="text-center">
                                    @if (item.TrangThai)
                                    {
                                        <span class="badge rounded-pill bg-success-subtle text-success-emphasis">
                                            Đang hoạt động
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill bg-secondary-subtle text-secondary-emphasis">
                                            Ngừng hoạt động
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="d-inline-flex gap-1">
                                        <button type="button"
                                                class="btn btn-sm btn-outline-primary"
                                                title="Sửa"
                                                onclick="moModalSua(this)"
                                                data-id="@item.MaQuyDinhDat"
                                                data-hang="@item.MaHang"
                                                data-km="@item.TongKm.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                                data-tudong="@item.SoGioTuDong.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                                data-bandem="@item.SoGioBanDem.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                                data-mota="@item.MoTa"
                                                data-trangthai="@item.TrangThai.ToString().ToLowerInvariant()">
                                            <i class="bi bi-pencil-square"></i>
                                        </button>

                                        <button type="button"
                                                class="btn btn-sm @(item.TrangThai ? "btn-outline-danger" : "btn-outline-success")"
                                                title="@(item.TrangThai ? "Ngừng hoạt động" : "Kích hoạt")"
                                                onclick="doiTrangThai('@item.MaQuyDinhDat', @item.TrangThai.ToString().ToLowerInvariant())">
                                            <i class="bi @(item.TrangThai ? "bi-toggle-on" : "bi-toggle-off")"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5">
                                <i class="bi bi-inbox fs-1 text-secondary"></i>
                                <div class="mt-2 text-secondary">
                                    Không tìm thấy quy định DAT.
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (totalPages > 1)
        {
            <div class="card-footer bg-white d-flex flex-wrap justify-content-between align-items-center gap-2">
                <small class="text-secondary">
                    Trang @(page) / @totalPages
                </small>

                <nav aria-label="Phân trang quy định DAT">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(page <= 1 ? "disabled" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-tuKhoa="@tuKhoa"
                               asp-route-page="@(page - 1)">
                                Trước
                            </a>
                        </li>

                        @for (int i = 1; i <= totalPages; i++)
                        {
                            <li class="page-item @(i == page ? "active" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-tuKhoa="@tuKhoa"
                                   asp-route-page="@i">@i</a>
                            </li>
                        }

                        <li class="page-item @(page >= totalPages ? "disabled" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-tuKhoa="@tuKhoa"
                               asp-route-page="@(page + 1)">
                                Sau
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

<!-- Modal thêm / sửa -->
<div class="modal fade" id="quyDinhModal" tabindex="-1"
     aria-labelledby="quyDinhModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow">
            <form id="quyDinhForm">
                @Html.AntiForgeryToken()

                <div class="modal-header">
                    <div>
                        <h5 class="modal-title fw-bold" id="quyDinhModalLabel">
                            Thêm quy định DAT
                        </h5>
                        <div class="small text-secondary">
                            Nhập chỉ tiêu theo hạng giấy phép lái xe.
                        </div>
                    </div>
                    <button type="button" class="btn-close"
                            data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>

                <div class="modal-body">
                    <div id="formError" class="alert alert-danger d-none"
                         role="alert" style="white-space: pre-line;"></div>

                    <input type="hidden" id="isEdit" value="false" />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="MaQuyDinhDat" class="form-label">
                                Mã quy định <span class="text-danger">*</span>
                            </label>
                            <input id="MaQuyDinhDat" name="MaQuyDinhDat"
                                   class="form-control" maxlength="20"
                                   required autocomplete="off"
                                   placeholder="Ví dụ: QD_DAT_B" />
                            <div class="form-text">
                                Mã phải duy nhất trong hệ thống.
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label for="MaHang" class="form-label">
                                Hạng GPLX <span class="text-danger">*</span>
                            </label>
                            <select id="MaHang" name="MaHang"
                                    class="form-select" required>
                                <option value="">-- Chọn hạng GPLX --</option>
                                @foreach (var hang in hangGplxes)
                                {
                                    <option value="@hang.MaHang">
                                        @hang.TenHang (@hang.MaHang)
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label for="TongKm" class="form-label">
                                Tổng số km <span class="text-danger">*</span>
                            </label>
                            <input id="TongKm" name="TongKm" type="number"
                                   class="form-control" min="0.01"
                                   step="0.01" required />
                        </div>

                        <div class="col-md-4">
                            <label for="SoGioTuDong" class="form-label">
                                Giờ xe số tự động <span class="text-danger">*</span>
                            </label>
                            <input id="SoGioTuDong" name="SoGioTuDong"
                                   type="number" class="form-control"
                                   min="0" step="0.01" required />
                        </div>

                        <div class="col-md-4">
                            <label for="SoGioBanDem" class="form-label">
                                Giờ ban đêm <span class="text-danger">*</span>
                            </label>
                            <input id="SoGioBanDem" name="SoGioBanDem"
                                   type="number" class="form-control"
                                   min="0" step="0.01" required />
                        </div>

                        <div class="col-12">
                            <label for="MoTa" class="form-label">Mô tả</label>
                            <textarea id="MoTa" name="MoTa" rows="3"
                                      class="form-control" maxlength="500"
                                      placeholder="Ghi chú về quy định..."></textarea>
                        </div>

                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input id="TrangThai" name="TrangThai"
                                       type="checkbox" class="form-check-input"
                                       role="switch" checked />
                                <label for="TrangThai" class="form-check-label">
                                    Quy định đang hoạt động
                                </label>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-light"
                            data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" id="btnLuu"
                            class="btn btn-primary">
                        <i class="bi bi-check-lg me-1"></i> Lưu quy định
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const modalElement = document.getElementById('quyDinhModal');
        const quyDinhModal = bootstrap.Modal.getOrCreateInstance(modalElement);
        const form = document.getElementById('quyDinhForm');
        const formError = document.getElementById('formError');
        const btnLuu = document.getElementById('btnLuu');

        const token = form.querySelector(
            'input[name="__RequestVerificationToken"]').value;

        function hienLoiForm(message) {
            formError.textContent = message || 'Có lỗi xảy ra.';
            formError.classList.remove('d-none');
        }

        function xoaLoiForm() {
            formError.textContent = '';
            formError.classList.add('d-none');
        }

        function moModalThem() {
            form.reset();
            xoaLoiForm();

            document.getElementById('isEdit').value = 'false';
            document.getElementById('MaQuyDinhDat').readOnly = false;
            document.getElementById('quyDinhModalLabel').textContent =
                'Thêm quy định DAT';
            document.getElementById('TrangThai').checked = true;

            quyDinhModal.show();
        }

        function moModalSua(button) {
            form.reset();
            xoaLoiForm();

            document.getElementById('isEdit').value = 'true';
            document.getElementById('MaQuyDinhDat').value =
                button.dataset.id;
            document.getElementById('MaQuyDinhDat').readOnly = true;
            document.getElementById('MaHang').value =
                button.dataset.hang;
            document.getElementById('TongKm').value =
                button.dataset.km;
            document.getElementById('SoGioTuDong').value =
                button.dataset.tudong;
            document.getElementById('SoGioBanDem').value =
                button.dataset.bandem;
            document.getElementById('MoTa').value =
                button.dataset.mota || '';
            document.getElementById('TrangThai').checked =
                button.dataset.trangthai === 'true';

            document.getElementById('quyDinhModalLabel').textContent =
                'Cập nhật quy định DAT';

            quyDinhModal.show();
        }

        form.addEventListener('submit', async function (event) {
            event.preventDefault();
            xoaLoiForm();

            if (!form.reportValidity()) return;

            const isEdit =
                document.getElementById('isEdit').value === 'true';

            const url = isEdit
                ? '@Url.Action("Edit", "QuyDinhDat")'
                : '@Url.Action("Create", "QuyDinhDat")';

            const data = new FormData(form);
            data.set('TrangThai',
                document.getElementById('TrangThai').checked
                    ? 'true' : 'false');

            btnLuu.disabled = true;
            btnLuu.innerHTML =
                '<span class="spinner-border spinner-border-sm me-1"></span> Đang lưu...';

            try {
                const response = await fetch(url, {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': token
                    },
                    body: data
                });

                const result = await response.json();

                if (!response.ok || !result.success) {
                    hienLoiForm(result.message || 'Không thể lưu quy định.');
                    return;
                }

                quyDinhModal.hide();

                await Swal.fire({
                    icon: 'success',
                    title: 'Thành công',
                    text: result.message,
                    timer: 1600,
                    showConfirmButton: false
                });

                window.location.reload();
            } catch (error) {
                hienLoiForm('Không thể kết nối máy chủ. Vui lòng thử lại.');
            } finally {
                btnLuu.disabled = false;
                btnLuu.innerHTML =
                    '<i class="bi bi-check-lg me-1"></i> Lưu quy định';
            }
        });

        async function doiTrangThai(id, dangHoatDong) {
            const actionText = dangHoatDong
                ? 'ngừng hoạt động' : 'kích hoạt';

            const confirm = await Swal.fire({
                icon: 'question',
                title: 'Xác nhận thay đổi',
                text: `Bạn có chắc muốn ${actionText} quy định ${id}?`,
                showCancelButton: true,
                confirmButtonText: 'Đồng ý',
                cancelButtonText: 'Hủy',
                reverseButtons: true
            });

            if (!confirm.isConfirmed) return;

            try {
                const data = new FormData();
                data.append('id', id);
                data.append('__RequestVerificationToken', token);

                const response = await fetch(
                    '@Url.Action("ToggleTrangThai", "QuyDinhDat")', {
                        method: 'POST',
                        headers: {
                            'RequestVerificationToken': token
                        },
                        body: data
                    });

                const result = await response.json();

                if (!response.ok || !result.success) {
                    await Swal.fire({
                        icon: 'error',
                        title: 'Không thể thực hiện',
                        text: result.message || 'Đã xảy ra lỗi.'
                    });
                    return;
                }

                await Swal.fire({
                    icon: 'success',
                    title: 'Thành công',
                    text: result.message,
                    timer: 1500,
                    showConfirmButton: false
                });

                window.location.reload();
            } catch (error) {
                await Swal.fire({
                    icon: 'error',
                    title: 'Lỗi kết nối',
                    text: 'Không thể kết nối máy chủ. Vui lòng thử lại.'
                });
            }
        }
    </script>
}
