@model TTDaoTaoLaiXe.Models.GiaoVien

@{
    ViewData["Title"] = "Chi tiết giáo viên";

    var hangDuocPhep = (Model.HangDuocPhepDay ?? string.Empty)
        .Split(',', StringSplitOptions.RemoveEmptyEntries)
        .Select(x => x.Trim())
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .ToList();

    var danhSachLop = Model.LopHocs?.ToList()
        ?? new List<TTDaoTaoLaiXe.Models.LopHoc>();

    var tongSoLop = danhSachLop.Count;

    var soLopDangHoatDong = danhSachLop.Count(l =>
        l.TrangThai == "Đang mở" ||
        l.TrangThai == "Đang học");

    var lichHocs = Model.LichHocs?
        .OrderByDescending(x => x.NgayHoc)
        .ThenByDescending(x => x.GioBatDau)
        .ToList()
        ?? new List<TTDaoTaoLaiXe.Models.LichHoc>();

    var tongLich = lichHocs.Count;

    var soLichDaHuy = lichHocs.Count(x =>
        string.Equals(
            x.TrangThai,
            "Đã hủy",
            StringComparison.OrdinalIgnoreCase));

    var homNay = DateOnly.FromDateTime(DateTime.Today);
    var gioHienTai = TimeOnly.FromDateTime(DateTime.Now);

    var soLichSapToi = lichHocs.Count(x =>
        !string.Equals(
            x.TrangThai,
            "Đã hủy",
            StringComparison.OrdinalIgnoreCase)
        &&
        (
            x.NgayHoc > homNay ||
            (x.NgayHoc == homNay && x.GioKetThuc > gioHienTai)
        ));
}

<style>
    .teacher-details {
        background: #f5f7fb;
        min-height: 100vh;
        padding: 24px;
        border-radius: 14px;
        color: #243247;
    }

    .teacher-page-title {
        font-weight: 750;
        letter-spacing: -.35px;
        color: #1e293b;
    }

    .teacher-subtitle {
        color: #718096;
        font-size: .92rem;
    }

    .teacher-card {
        background: #fff;
        border: 1px solid #e5eaf1;
        border-radius: 14px;
        box-shadow: 0 3px 12px rgba(15, 23, 42, .035);
        overflow: hidden;
    }

    .teacher-card-header {
        padding: 18px 22px;
        border-bottom: 1px solid #edf0f5;
        font-weight: 700;
        color: #243247;
    }

    .teacher-card-body {
        padding: 22px;
    }

    .info-label {
        color: #718096;
        font-size: .82rem;
        margin-bottom: 6px;
    }

    .info-value {
        color: #243247;
        font-weight: 500;
        overflow-wrap: anywhere;
        line-height: 1.55;
    }

    .teacher-avatar {
        width: 66px;
        height: 66px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 17px;
        background: #e8f1ff;
        color: #1769d2;
        font-size: 1.8rem;
    }

    .license-chip {
        display: inline-flex;
        align-items: center;
        padding: 7px 12px;
        margin: 3px 5px 3px 0;
        border-radius: 9px;
        background: #edf5ff;
        border: 1px solid #dbeafe;
        color: #175bb5;
        font-size: .84rem;
        font-weight: 650;
    }

    .stat-card {
        background: #fff;
        border: 1px solid #e5eaf1;
        border-radius: 14px;
        padding: 18px 20px;
        height: 100%;
        box-shadow: 0 3px 12px rgba(15, 23, 42, .025);
    }

    .stat-icon {
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        font-size: 1.2rem;
        flex-shrink: 0;
    }

    .stat-number {
        font-size: 1.65rem;
        font-weight: 750;
        line-height: 1.2;
        color: #243247;
    }

    .stat-label {
        color: #718096;
        font-size: .84rem;
        margin-bottom: 7px;
    }

    .table {
        margin-bottom: 0;
    }

        .table thead th {
            white-space: nowrap;
            font-size: .8rem;
            font-weight: 700;
            color: #637083;
            background: #f8fafc;
            border-bottom: 1px solid #e8edf4;
            padding: 14px 12px;
        }

        .table tbody td {
            vertical-align: middle;
            padding: 14px 12px;
            border-color: #edf0f5;
            font-size: .88rem;
        }

        .table tbody tr:last-child td {
            border-bottom: 0;
        }

        .table tbody tr:hover {
            background: #fafcff;
        }

    .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 6px 10px;
        border-radius: 8px;
        font-size: .78rem;
        font-weight: 650;
        white-space: nowrap;
    }

    .status-active {
        color: #167647;
        background: #e8f7ee;
    }

    .status-inactive {
        color: #64748b;
        background: #eef1f5;
    }

    .status-cancelled {
        color: #b42318;
        background: #fef0ef;
    }

    .status-neutral {
        color: #475569;
        background: #f1f5f9;
    }

    .status-upcoming {
        color: #175bb5;
        background: #edf5ff;
    }

    .status-past {
        color: #6b7280;
        background: #f3f4f6;
    }

    .section-icon {
        color: #1769d2;
        margin-right: 8px;
    }

    .empty-state {
        padding: 52px 20px;
        text-align: center;
    }

    .empty-state-icon {
        font-size: 2.5rem;
        color: #a0aec0;
    }

    .teacher-name {
        font-size: 1.2rem;
        font-weight: 750;
        color: #1e293b;
        overflow-wrap: anywhere;
    }

    .schedule-content {
        min-width: 150px;
        max-width: 260px;
        white-space: normal;
        overflow-wrap: anywhere;
    }

    @@media (max-width: 767.98px) {
        .teacher-details {
            padding: 12px;
        }

        .teacher-card-header {
            padding: 16px;
        }

        .teacher-card-body {
            padding: 16px;
        }

        .stat-card {
            padding: 15px;
        }

        .teacher-avatar {
            width: 54px;
            height: 54px;
            font-size: 1.5rem;
        }
    }
</style>

<div class="teacher-details">

    <!-- Tiêu đề trang -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h4 class="teacher-page-title mb-2">
                Chi tiết giáo viên
            </h4>

            <div class="teacher-subtitle">
                Quản lý hồ sơ, chuyên môn và quá trình giảng dạy
            </div>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            Quay lại danh sách
        </a>
    </div>

    <!-- Thông tin tổng quan -->
    <div class="teacher-card mb-4">
        <div class="teacher-card-body">
            <div class="d-flex flex-wrap align-items-center gap-3">

                <div class="teacher-avatar">
                    <i class="bi bi-person-badge"></i>
                </div>

                <div class="flex-grow-1">
                    <div class="teacher-name mb-1">
                        @(string.IsNullOrWhiteSpace(Model.HoTen)
                                                ? "Chưa cập nhật họ tên"
                                                : Model.HoTen)
                    </div>

                    <div class="text-muted small">
                        Mã giáo viên:
                        <strong class="text-dark">
                            @Model.MaGiaoVien
                        </strong>
                    </div>

                    <div class="text-muted small mt-1">
                        <i class="bi bi-award me-1"></i>
                        @(string.IsNullOrWhiteSpace(Model.ChuyenMon)
                                                ? "Chưa cập nhật chuyên môn"
                                                : Model.ChuyenMon)
                    </div>
                </div>

                <div>
                    @if (Model.TrangThai)
                    {
                        <span class="status-pill status-active">
                            <i class="bi bi-check-circle-fill"></i>
                            Đang hoạt động
                        </span>
                    }
                    else
                    {
                        <span class="status-pill status-inactive">
                            <i class="bi bi-pause-circle-fill"></i>
                            Ngừng hoạt động
                        </span>
                    }
                </div>

            </div>
        </div>
    </div>

    <!-- Thống kê -->
    <div class="row g-3 mb-4">

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="stat-card">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon"
                         style="background:#e8f1ff;color:#1769d2;">
                        <i class="bi bi-people"></i>
                    </div>

                    <div>
                        <div class="stat-label">Lớp đang hoạt động</div>
                        <div class="stat-number">@soLopDangHoatDong</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="stat-card">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon"
                         style="background:#e8f7ee;color:#16804a;">
                        <i class="bi bi-calendar-check"></i>
                    </div>

                    <div>
                        <div class="stat-label">Lịch sắp tới</div>
                        <div class="stat-number">@soLichSapToi</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="stat-card">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon"
                         style="background:#f0eaff;color:#7048c8;">
                        <i class="bi bi-calendar-week"></i>
                    </div>

                    <div>
                        <div class="stat-label">Tổng lịch giảng dạy</div>
                        <div class="stat-number">@tongLich</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="stat-card">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon"
                         style="background:#fff0e8;color:#c45b21;">
                        <i class="bi bi-calendar-x"></i>
                    </div>

                    <div>
                        <div class="stat-label">Lịch đã hủy</div>
                        <div class="stat-number">@soLichDaHuy</div>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <div class="row g-4">

        <!-- Hồ sơ cá nhân -->
        <div class="col-12 col-xl-8">
            <div class="teacher-card h-100">

                <div class="teacher-card-header">
                    <i class="bi bi-person-lines-fill section-icon"></i>
                    Thông tin cá nhân
                </div>

                <div class="teacher-card-body">
                    <div class="row g-4">

                        <div class="col-12 col-md-6">
                            <div class="info-label">Họ và tên</div>
                            <div class="info-value">
                                @(string.IsNullOrWhiteSpace(Model.HoTen)
                                                                ? "Chưa cập nhật"
                                                                : Model.HoTen)
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <div class="info-label">Ngày sinh</div>
                            <div class="info-value">
                                @(Model.NgaySinh?.ToString("dd/MM/yyyy")
                                                                ?? "Chưa cập nhật")
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <div class="info-label">Giới tính</div>
                            <div class="info-value">
                                @(string.IsNullOrWhiteSpace(Model.GioiTinh)
                                                                ? "Chưa cập nhật"
                                                                : Model.GioiTinh)
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <div class="info-label">Số CCCD</div>
                            <div class="info-value">
                                @(string.IsNullOrWhiteSpace(Model.Cccd)
                                                                ? "Chưa cập nhật"
                                                                : Model.Cccd)
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <div class="info-label">Số điện thoại</div>
                            <div class="info-value">
                                @(string.IsNullOrWhiteSpace(Model.SoDienThoai)
                                                                ? "Chưa cập nhật"
                                                                : Model.SoDienThoai)
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <div class="info-label">Email</div>
                            <div class="info-value">
                                @(string.IsNullOrWhiteSpace(Model.Email)
                                                                ? "Chưa cập nhật"
                                                                : Model.Email)
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="info-label">Địa chỉ</div>
                            <div class="info-value">
                                @(string.IsNullOrWhiteSpace(Model.DiaChi)
                                                                ? "Chưa cập nhật"
                                                                : Model.DiaChi)
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="info-label">Ghi chú</div>
                            <div class="info-value">
                                @(string.IsNullOrWhiteSpace(Model.GhiChu)
                                                                ? "Không có ghi chú"
                                                                : Model.GhiChu)
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>

        <!-- Thông tin chuyên môn -->
        <div class="col-12 col-xl-4">
            <div class="teacher-card h-100">

                <div class="teacher-card-header">
                    <i class="bi bi-award section-icon"></i>
                    Thông tin chuyên môn
                </div>

                <div class="teacher-card-body">

                    <div class="mb-4">
                        <div class="info-label">Chuyên môn</div>
                        <div class="info-value">
                            @(string.IsNullOrWhiteSpace(Model.ChuyenMon)
                                                        ? "Chưa cập nhật"
                                                        : Model.ChuyenMon)
                        </div>
                    </div>

                    <div class="mb-4">
                        <div class="info-label">Số giấy phép lái xe</div>
                        <div class="info-value">
                            @(string.IsNullOrWhiteSpace(Model.SoGiayPhepLaiXe)
                                                        ? "Chưa cập nhật"
                                                        : Model.SoGiayPhepLaiXe)
                        </div>
                    </div>

                    <div class="mb-4">
                        <div class="info-label">Hạng được phép giảng dạy</div>

                        @if (hangDuocPhep.Any())
                        {
                            <div class="mt-2">
                                @foreach (var hang in hangDuocPhep)
                                {
                                    <span class="license-chip">
                                        <i class="bi bi-patch-check me-1"></i>
                                        @hang
                                    </span>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-muted small mt-2">
                                Chưa cập nhật hạng được phép dạy.
                            </div>
                        }
                    </div>

                    <hr class="my-4" />

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="info-label mb-0">
                            Tổng số lớp đã liên kết
                        </div>
                        <strong>@tongSoLop</strong>
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        <div class="info-label mb-0">
                            Lớp đang mở hoặc đang học
                        </div>
                        <strong class="text-primary">
                            @soLopDangHoatDong
                        </strong>
                    </div>

                    <div class="small text-muted mt-3">
                        Thống kê lớp được tính từ các lớp liên kết trực tiếp
                        với hồ sơ giáo viên.
                    </div>

                </div>
            </div>
        </div>

        <!-- Lịch giảng dạy và lịch sử -->
        <div class="col-12">
            <div class="teacher-card">

                <div class="teacher-card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div>
                        <i class="bi bi-calendar-week section-icon"></i>
                        Lịch giảng dạy và lịch sử
                    </div>

                    <span class="badge rounded-pill bg-light text-dark border">
                        @tongLich lịch
                    </span>
                </div>

                @if (lichHocs.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th class="ps-4">STT</th>
                                    <th>Ngày học</th>
                                    <th>Lớp học</th>
                                    <th>Thời gian</th>
                                    <th>Loại buổi học</th>
                                    <th>Nội dung</th>
                                    <th>Trạng thái</th>
                                    <th class="pe-4">Phân loại</th>
                                </tr>
                            </thead>

                            <tbody>
                                @{
                                    var stt = 0;
                                }

                                @foreach (var lich in lichHocs)
                                {
                                    stt++;

                                    var daHuy = string.Equals(
                                    lich.TrangThai,
                                    "Đã hủy",
                                    StringComparison.OrdinalIgnoreCase);

                                    var daQuaGio =
                                    lich.NgayHoc < homNay ||
                                    (
                                    lich.NgayHoc == homNay &&
                                    lich.GioKetThuc <= gioHienTai
                                    );

                                    var laLichSu = daHuy || daQuaGio;

                                    var tenLop = lich.MaLopHocNavigation?.TenLopHoc;

                                    <tr>
                                        <td class="ps-4 text-muted">
                                            @stt
                                        </td>

                                        <td class="text-nowrap">
                                            <div class="fw-semibold">
                                                @lich.NgayHoc.ToString("dd/MM/yyyy")
                                            </div>

                                            @if (lich.NgayHoc == homNay)
                                            {
                                                <span class="small text-primary">
                                                    Hôm nay
                                                </span>
                                            }
                                    </td>

                                    <td>
                                        <div class="fw-semibold">
                                            @(string.IsNullOrWhiteSpace(tenLop)
                                                                                    ? lich.MaLopHoc ?? "Chưa phân lớp"
                                                                                    : tenLop)
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(lich.MaLopHoc))
                                            {
                                                <div class="small text-muted">
                                                    @lich.MaLopHoc
                                                </div>
                                            }
                                    </td>

                                    <td class="text-nowrap">
                                        <div class="fw-semibold">
                                            @lich.GioBatDau.ToString("HH:mm")
                                            –
                                            @lich.GioKetThuc.ToString("HH:mm")
                                        </div>
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(lich.LoaiBuoiHoc)
                                                                            ? "Chưa cập nhật"
                                                                            : lich.LoaiBuoiHoc)
                                                                                           </td>

                                    <td>
                                        <div class="schedule-content">
                                            @(string.IsNullOrWhiteSpace(lich.NoiDung)
                                                                                    ? "Chưa cập nhật"
                                                                                    : lich.NoiDung)
                                    </div>
                                </td>

                                        <td>
                                    @if (daHuy)
                                            {
                                                <span class="status-pill status-cancelled">
                                                    <i class="bi bi-x-circle"></i>
                                                    Đã hủy
                                                </span>
                                            }
                                            else if (string.Equals(
                                            lich.TrangThai,
                                            "Đã lên lịch",
                                            StringComparison.OrdinalIgnoreCase))
                                            {
                                                <span class="status-pill status-upcoming">
                                                    <i class="bi bi-calendar-check"></i>
                                                    Đã lên lịch
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="status-pill status-neutral">
                                                    @(
                                                                                            string.IsNullOrWhiteSpace(lich.TrangThai)
                                                                                            ? "Chưa cập nhật"
                                                                                            : lich.TrangThai
                                                                                            )
                                    </span>
                                                                        }
                                        </td>

                                        <td class="pe-4">
                                            @if (daHuy)
                                            {
                                                <span class="text-danger small">
                                                    <i class="bi bi-calendar-x me-1"></i>
                                                    Lịch đã hủy
                                                </span>
                                            }
                                            else if (laLichSu)
                                            {
                                                <span class="status-pill status-past">
                                                    <i class="bi bi-clock-history"></i>
                                                    Đã qua giờ
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="status-pill status-upcoming">
                                                    <i class="bi bi-calendar-event"></i>
                                                    Sắp tới
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <div class="empty-state-icon">
                            <i class="bi bi-calendar2-x"></i>
                        </div>

                        <div class="fw-bold mt-3">
                            Chưa có lịch giảng dạy
                        </div>

                        <div class="text-muted small mt-2">
                            Giáo viên chưa có buổi học nào được ghi nhận
                            trong hệ thống.
                        </div>
                    </div>
                }

                <div class="border-top px-4 py-3 bg-light">
                    <div class="small text-muted">
                        <i class="bi bi-info-circle me-1"></i>
                        “Đã qua giờ” chỉ thể hiện thời gian buổi học đã kết thúc
                        theo lịch, không khẳng định buổi học đã được hoàn thành.
                        Trạng thái buổi học được hiển thị riêng ở cột trạng thái.
                    </div>
                </div>

            </div>
        </div>

    </div>
</div>