
@model IEnumerable<TTDaoTaoLaiXe.Models.PhongHoc>

@{
    ViewData["Title"] = "Quản lý phòng học";

    var tuKhoa = ViewBag.TuKhoa as string ?? "";
    var trangThaiLoc = ViewBag.TrangThaiLoc as string ?? "";
    int page = ViewBag.Page ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalItems = ViewBag.TotalItems ?? 0;
}

<div class="container-fluid py-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h3 class="fw-bold mb-1">Quản lý phòng học</h3>
            <div class="text-muted">Theo dõi thông tin, sức chứa và trạng thái phòng học.</div>
        </div>
        <button type="button" class="btn btn-primary"
                data-bs-toggle="modal" data-bs-target="#modalThemPhong">
            <i class="bi bi-plus-lg me-1"></i> Thêm phòng học
        </button>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-3 bg-primary bg-opacity-10 text-primary p-3">
                        <i class="bi bi-door-open fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Tổng số phòng trong kết quả</div>
                        <div class="fs-4 fw-bold">@totalItems</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-3 bg-success bg-opacity-10 text-success p-3">
                        <i class="bi bi-check-circle fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Trang hiện tại</div>
                        <div class="fs-4 fw-bold">@(page) / @totalPages</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body border-bottom">
            <form method="get" asp-action="Index" class="row g-2 align-items-end">
                <div class="col-md-6 col-lg-7">
                    <label class="form-label">Tìm kiếm</label>
                    <input type="text" name="tuKhoa" value="@tuKhoa"
                           class="form-control"
                           placeholder="Mã phòng, tên phòng, loại phòng, vị trí..." />
                </div>
                <div class="col-md-4 col-lg-3">
                    <label class="form-label">Trạng thái</label>
                    <select name="trangThai" class="form-select">
                        <option value="" selected="@(trangThaiLoc == "")">Tất cả trạng thái</option>
                        <option value="1" selected="@(trangThaiLoc == "1")">Đang hoạt động</option>
                        <option value="0" selected="@(trangThaiLoc == "0")">Ngừng hoạt động</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-search me-1"></i> Tìm
                    </button>
                </div>
            </form>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="text-nowrap">Mã phòng</th>
                        <th>Tên phòng</th>
                        <th>Loại phòng</th>
                        <th class="text-center">Sức chứa</th>
                        <th>Vị trí</th>
                        <th class="text-center">Trạng thái</th>
                        <th class="text-center" style="min-width: 160px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var p in Model)
                        {
                            <tr>
                                <td class="fw-semibold text-nowrap">@p.MaPhong</td>
                                <td>@p.TenPhong</td>
                                <td>@p.LoaiPhong</td>
                                <td class="text-center">@p.SucChua</td>
                                <td>@(string.IsNullOrWhiteSpace(p.ViTri) ? "—" : p.ViTri)</td>
                                <td class="text-center">
                                    @if (p.TrangThai)
                                    {
                                        <span class="badge rounded-pill text-bg-success">Đang hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill text-bg-secondary">Ngừng hoạt động</span>
                                    }
                                </td>
                                <td class="text-center text-nowrap">
                                    <button type="button"
                                            class="btn btn-sm btn-outline-primary btn-sua-phong"
                                            data-bs-toggle="modal"
                                            data-bs-target="#modalSuaPhong"
                                            data-ma="@p.MaPhong"
                                            data-ten="@p.TenPhong"
                                            data-loai="@p.LoaiPhong"
                                            data-succhua="@p.SucChua"
                                            data-vitri="@p.ViTri"
                                            data-ghichu="@p.GhiChu">
                                        <i class="bi bi-pencil-square me-1"></i>Sửa
                                    </button>
                                    <button type="button"
                                            class="btn btn-sm @(p.TrangThai ? "btn-outline-danger" : "btn-outline-success") btn-doi-trang-thai"
                                            data-ma="@p.MaPhong"
                                            data-ten="@p.TenPhong"
                                            data-trangthai="@p.TrangThai.ToString().ToLowerInvariant()">
                                        <i class="bi @(p.TrangThai ? "bi-pause-circle" : "bi-play-circle") me-1"></i>
                                        @(p.TrangThai ? "Ngừng" : "Kích hoạt")
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5">
                                <i class="bi bi-inbox fs-1 text-muted d-block mb-2"></i>
                                <div class="fw-semibold">Không tìm thấy phòng học</div>
                                <div class="text-muted small">Thử thay đổi từ khóa hoặc bộ lọc.</div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (totalPages > 1)
        {
            <div class="card-footer bg-white d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div class="text-muted small">Trang @(page) trên @totalPages</div>
                <nav aria-label="Phân trang phòng học">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(page <= 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-tuKhoa="@tuKhoa"
                               asp-route-trangThai="@trangThaiLoc"
                               asp-route-page="@(page - 1)">Trước</a>
                        </li>
                        @for (int i = 1; i <= totalPages; i++)
                        {
                            <li class="page-item @(i == page ? "active" : "")">
                                <a class="page-link" asp-action="Index"
                                   asp-route-tuKhoa="@tuKhoa"
                                   asp-route-trangThai="@trangThaiLoc"
                                   asp-route-page="@i">@i</a>
                            </li>
                        }
                        <li class="page-item @(page >= totalPages ? "disabled" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-tuKhoa="@tuKhoa"
                               asp-route-trangThai="@trangThaiLoc"
                               asp-route-page="@(page + 1)">Sau</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

<div class="modal fade" id="modalThemPhong" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <form id="formThemPhong" asp-controller="PhongHoc" asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">
                        <i class="bi bi-plus-circle me-2"></i>Thêm phòng học
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Mã phòng <span class="text-danger">*</span></label>
                            <input name="MaPhong" class="form-control" maxlength="20" required
                                   placeholder="Ví dụ: PH001" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Tên phòng <span class="text-danger">*</span></label>
                            <input name="TenPhong" class="form-control" maxlength="100" required
                                   placeholder="Nhập tên phòng" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Loại phòng <span class="text-danger">*</span></label>
                            <input name="LoaiPhong" class="form-control" maxlength="50" required
                                   placeholder="Ví dụ: Lý thuyết, Mô phỏng..." />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Sức chứa <span class="text-danger">*</span></label>
                            <input name="SucChua" type="number" class="form-control" min="1" value="30" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Vị trí</label>
                            <input name="ViTri" class="form-control" maxlength="255"
                                   placeholder="Ví dụ: Tầng 2, khu A" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Ghi chú</label>
                            <textarea name="GhiChu" class="form-control" rows="3" maxlength="500"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg me-1"></i>Lưu phòng học
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="modalSuaPhong" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <form id="formSuaPhong" asp-controller="PhongHoc" asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">
                        <i class="bi bi-pencil-square me-2"></i>Cập nhật phòng học
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="MaPhong" id="suaMaPhong" />
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Mã phòng</label>
                            <input id="suaMaPhongHienThi" class="form-control" readonly />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Tên phòng <span class="text-danger">*</span></label>
                            <input name="TenPhong" id="suaTenPhong" class="form-control" maxlength="100" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Loại phòng <span class="text-danger">*</span></label>
                            <input name="LoaiPhong" id="suaLoaiPhong" class="form-control" maxlength="50" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Sức chứa <span class="text-danger">*</span></label>
                            <input name="SucChua" id="suaSucChua" type="number" class="form-control" min="1" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Vị trí</label>
                            <input name="ViTri" id="suaViTri" class="form-control" maxlength="255" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Ghi chú</label>
                            <textarea name="GhiChu" id="suaGhiChu" class="form-control" rows="3" maxlength="500"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg me-1"></i>Lưu thay đổi
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const formThem = document.getElementById("formThemPhong");
            const formSua = document.getElementById("formSuaPhong");

            function hienThongBaoLoi(message) {
                if (typeof Swal !== "undefined") {
                    Swal.fire({
                        icon: "error",
                        title: "Không thành công",
                        text: message || "Đã xảy ra lỗi. Vui lòng thử lại."
                    });
                } else {
                    console.error(message);
                }
            }

            function layThongBaoLoi(data) {
                if (data?.errors) {
                    const loiDauTien = Object.values(data.errors).flat()[0];
                    if (loiDauTien) return loiDauTien;
                }
                return data?.message || "Không thể xử lý yêu cầu.";
            }

            async function guiForm(form) {
                const nutLuu = form.querySelector('button[type="submit"]');
                const noiDungNut = nutLuu.innerHTML;

                nutLuu.disabled = true;
                nutLuu.innerHTML =
                    '<span class="spinner-border spinner-border-sm me-1"></span>Đang lưu...';

                try {
                    const response = await fetch(form.action, {
                        method: "POST",
                        body: new FormData(form),
                        headers: { "X-Requested-With": "XMLHttpRequest" }
                    });

                    let data;
                    try {
                        data = await response.json();
                    } catch {
                        throw new Error(
                            response.status === 400
                                ? "Yêu cầu không hợp lệ hoặc mã bảo mật hết hạn. Hãy tải lại trang rồi thử lại."
                                : `Máy chủ trả về lỗi HTTP ${response.status}.`
                        );
                    }

                    if (!response.ok || !data.success) {
                        hienThongBaoLoi(layThongBaoLoi(data));
                        return;
                    }

                    if (typeof Swal !== "undefined") {
                        await Swal.fire({
                            icon: "success",
                            title: "Thành công",
                            text: data.message || "Đã lưu phòng học.",
                            timer: 1500,
                            showConfirmButton: false
                        });
                    }

                    window.location.reload();
                } catch (error) {
                    hienThongBaoLoi(error.message || "Không thể kết nối đến máy chủ.");
                } finally {
                    nutLuu.disabled = false;
                    nutLuu.innerHTML = noiDungNut;
                }
            }

            formThem.addEventListener("submit", function (event) {
                event.preventDefault();
                if (formThem.reportValidity()) guiForm(formThem);
            });

            formSua.addEventListener("submit", function (event) {
                event.preventDefault();
                if (formSua.reportValidity()) guiForm(formSua);
            });

            document.querySelectorAll(".btn-sua-phong").forEach(function (button) {
                button.addEventListener("click", function () {
                    const d = button.dataset;
                    document.getElementById("suaMaPhong").value = d.ma || "";
                    document.getElementById("suaMaPhongHienThi").value = d.ma || "";
                    document.getElementById("suaTenPhong").value = d.ten || "";
                    document.getElementById("suaLoaiPhong").value = d.loai || "";
                    document.getElementById("suaSucChua").value = d.succhua || "1";
                    document.getElementById("suaViTri").value = d.vitri || "";
                    document.getElementById("suaGhiChu").value = d.ghichu || "";
                });
            });

            document.querySelectorAll(".btn-doi-trang-thai").forEach(function (button) {
                button.addEventListener("click", async function () {
                    const maPhong = button.dataset.ma;
                    const tenPhong = button.dataset.ten;
                    const dangHoatDong = button.dataset.trangthai === "true";
                    const hanhDong = dangHoatDong ? "ngừng hoạt động" : "kích hoạt";

                    if (typeof Swal === "undefined") {
                        hienThongBaoLoi("Không tìm thấy thư viện SweetAlert2.");
                        return;
                    }

                    const xacNhan = await Swal.fire({
                        icon: "warning",
                        title: "Xác nhận thao tác",
                        text: `Bạn có chắc muốn ${hanhDong} phòng "${tenPhong}" (${maPhong})?`,
                        showCancelButton: true,
                        confirmButtonText: "Xác nhận",
                        cancelButtonText: "Hủy",
                        confirmButtonColor: dangHoatDong ? "#dc3545" : "#198754"
                    });

                    if (!xacNhan.isConfirmed) return;

                    const token = document.querySelector(
                        '#formThemPhong input[name="__RequestVerificationToken"]'
                    )?.value;

                    if (!token) {
                        hienThongBaoLoi("Không tìm thấy mã bảo mật. Hãy tải lại trang rồi thử lại.");
                        return;
                    }

                    button.disabled = true;

                    try {
                        const body = new FormData();
                        body.append("maPhong", maPhong);
                        body.append("__RequestVerificationToken", token);

                        const response = await fetch(
                            '@Url.Action("ToggleTrangThai", "PhongHoc")',
                            {
                                method: "POST",
                                body: body,
                                headers: { "X-Requested-With": "XMLHttpRequest" }
                            }
                        );

                        let data;
                        try {
                            data = await response.json();
                        } catch {
                            throw new Error(`Máy chủ trả về lỗi HTTP ${response.status}.`);
                        }

                        if (!response.ok || !data.success) {
                            hienThongBaoLoi(layThongBaoLoi(data));
                            return;
                        }

                        await Swal.fire({
                            icon: "success",
                            title: "Thành công",
                            text: data.message,
                            timer: 1400,
                            showConfirmButton: false
                        });

                        window.location.reload();
                    } catch (error) {
                        hienThongBaoLoi(error.message || "Không thể kết nối đến máy chủ.");
                    } finally {
                        button.disabled = false;
                    }
                });
            });
        });
    </script>
}
